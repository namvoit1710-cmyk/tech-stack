# App
APP_NAME=AI Eagle
APP_VERSION=0.1.0
APP_MODE=REST

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Default tenant used when a request omits tenant_id
DEFAULT_TENANT_ID=default-tenant
# Resume persisted running background jobs on app startup
ENABLE_RESUME_RUNNING_BACKGROUND_JOBS=False

# Embeddings
EMBEDDING_MODEL_NAME=microsoft/harrier-oss-v1-270m
EMBEDDING_VECTOR_DIMENSIONS=640
EMBEDDING_QUERY_INSTRUCTION=Represent this query for retrieving relevant documents:
EMBEDDING_BATCH_SIZE=32
INGESTION_MAX_EMBEDDING_INPUT_CHARACTERS=4000
INGESTION_DEFAULT_CHUNK_SIZE_CHARACTERS=800

# OpenAI
# Leave OPENAI_API_KEY empty to use the local stub LLM service.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BACKOFF_SECONDS=1.0

# File service
FILE_SERVICE_BASE_URL=
FILE_SERVICE_TIMEOUT_SECONDS=60.0

# Local file storage
LOCAL_FILE_STORAGE_PATH=./local-files
LOCAL_UPLOAD_MAX_BYTES=104857600

# SAP HANA
HANA_HOST=localhost
HANA_PORT=443
HANA_USER=SYSTEM
HANA_PASSWORD=
HANA_SCHEMA=AI_EAGLE
HANA_POOL_SIZE=5
HANA_POOL_TIMEOUT_SECONDS=30
HANA_STATEMENT_TIMEOUT_MS=30000
# Auto-create HANA schema tables on startup
AUTO_CREATE_SCHEMA=False
# Optionally run deployment/seed/*.sql after schema initialization
AUTO_SEED_DATA=False

# Graph / retrieval tuning
GRAPH_WORKSPACE_NAME=RAG_GRAPH_WORKSPACE
GRAPH_SEED_TOP_K=8
GRAPH_NEIGHBOR_CAP_PER_SEED=6
GRAPH_MAX_RELATION_CANDIDATES=24
GRAPH_MAX_GRAPH_CHUNK_CANDIDATES=16

# Resilience
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=60.0
