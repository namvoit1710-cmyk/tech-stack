# Governance Smart API — environment variables.
# Copy to `.env` for local runs: `cp env.example .env` then fill in secrets.
# Values below are the code defaults from
# smart_service_sdk/layer4_frameworks/config/app_config.py (settings are shared,
# since governance composes the SDK app). SECRETS are intentionally left blank.

# === App ===
APP_NAME=Governance Smart API
APP_VERSION=0.1.0
APP_MODE=REST
LOG_LEVEL=INFO
LOG_FORMAT=text
DEFAULT_TENANT_ID=default-tenant
ENABLE_RESUME_RUNNING_BACKGROUND_JOBS=true

# === Runtime port ===
# CloudFoundry injects PORT at runtime; main.py falls back to 8080 locally.
PORT=8080

# === SAP HANA Cloud ===
# HANA_PASSWORD is a SECRET — leave blank here; set via `cf set-env` / a bound service.
HANA_HOST=
HANA_PORT=443
HANA_USER=SYSTEM
HANA_PASSWORD=
HANA_SCHEMA=
HANA_POOL_SIZE=5
HANA_POOL_TIMEOUT_SECONDS=30
HANA_STATEMENT_TIMEOUT_MS=30000
AUTO_CREATE_SCHEMA=false
AUTO_SEED_DATA=false

# === Embeddings / ingestion ===
EMBEDDING_MODEL_NAME=microsoft/harrier-oss-v1-270m
EMBEDDING_VECTOR_DIMENSIONS=640
EMBEDDING_QUERY_INSTRUCTION=Represent this query for retrieving relevant documents:
EMBEDDING_BATCH_SIZE=32
INGESTION_MAX_EMBEDDING_INPUT_CHARACTERS=4000
INGESTION_DEFAULT_CHUNK_SIZE_CHARACTERS=800

# === OpenAI ===
# OPENAI_API_KEY is a SECRET — leave blank here; blank => SDK uses a local stub LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BACKOFF_SECONDS=1.0

# === Local file storage ===
LOCAL_FILE_STORAGE_PATH=./local-files
LOCAL_UPLOAD_MAX_BYTES=104857600

# === File service (optional) ===
FILE_SERVICE_BASE_URL=
FILE_SERVICE_TIMEOUT_SECONDS=60.0

# === Knowledge graph tuning ===
GRAPH_WORKSPACE_NAME=RAG_GRAPH_WORKSPACE
SPACY_MODEL_NAME=en_core_web_sm
GRAPH_SEED_TOP_K=8
GRAPH_NEIGHBOR_CAP_PER_SEED=6
GRAPH_MAX_RELATION_CANDIDATES=24
GRAPH_MAX_GRAPH_CHUNK_CANDIDATES=16

# === Circuit breaker ===
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=60.0
