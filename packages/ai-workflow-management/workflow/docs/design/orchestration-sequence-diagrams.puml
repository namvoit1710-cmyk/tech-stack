title Start Run Flow\n<size:10><color:#BB0000>Red arrows = ASYNC boundary (queue handoff)</color> | <color:#354A5F>Dark arrows = SYNC (same call stack)</color></size>

actor "API Client" as api
participant "StartRunUseCase" as uc SAP_BLUE
participant "DAGPreparer" as dag SAP_GREEN
participant "RunRepo" as repo SAP_TEAL
participant "EventPublisher" as pub SAP_NAVY
participant "OrchestrationQueue" as queue SAP_RED
participant "OrchestrationWorker" as worker SAP_RED
participant "OrchestrationEngine" as engine SAP_BLUE

== SYNC: API Request Handling (single call stack) ==

api -> uc : execute(workflow_id, input)
activate uc

uc -> uc : Fetch & validate workflow
uc -> dag : prepare(workflow)
activate dag
dag --> uc : DAGInfo (edge_map, entry_nodes, leaf_nodes)
deactivate dag

uc -> uc : Create WorkflowRun (status=CREATED)
uc -> uc : Store input as CSV file
uc -> uc : Transition to RUNNING

uc -> repo : save(run)
activate repo
deactivate repo

uc -> pub : publish run.started
activate pub
deactivate pub

uc -[#BB0000]> queue : enqueue(StartRunAction)
activate queue
note right of queue #FFF0E0
  **ASYNC BOUNDARY**
  API response returns immediately.
  Engine processes later via worker.
end note
deactivate queue

uc --> api : return run_id
deactivate uc

== ~~~ ASYNC BOUNDARY ~~~ (queue decouples request from orchestration) ==

... Worker polls queue (different async context) ...

worker -[#BB0000]>> queue : dequeue()
activate worker
activate queue
queue --> worker : StartRunAction(run_id)
deactivate queue

== SYNC: Engine Orchestration (single call stack under run lock) ==

worker -> engine : orchestrate_start(run_id)
activate engine

engine -> engine : Acquire run lock
engine -> engine : Validate DAG

engine -> engine : handle_entry_nodes(entry_node_ids)
note over engine
  **SYNC loop** — for each entry node:
  Route by type (BUILTIN/PENDING/TASK).
  BUILTIN: invoke handler + recurse.
  PENDING: invoke handler + save (pauses).
  TASK: resolve input + dispatch to worker.
end note

engine -> engine : check_run_completion()
engine -> engine : drain_events()

deactivate engine
deactivate worker

@enduml


