== SYNC: Pause Phase (engine call stack) ==

engine -> engine : dispatch_or_handle_task(task)\n[PENDING branch]
activate engine

engine -> handler : invoke_handler(node, run, ...)
activate handler
note over handler
  **SYNC** — handler creates
  pending task(s) with status=PENDING.
  No external I/O.
end note
handler --> engine : NodeHandlerResult\n(pending tasks, events)
deactivate handler

engine -> repo : save pending tasks (SYNC)
activate repo
deactivate repo

engine -> pub : task.dispatched (IMMEDIATE, published now)
activate pub
deactivate pub

engine -> pub : handler events (IMMEDIATE, published now)\n  e.g. input.requested, human_action.requested
activate pub
deactivate pub

note over engine #FFF0E0
  **RUN PAUSES HERE**
  Engine call stack ENDS.
  No successors dispatched.
  No drain_events — events already
  published IMMEDIATELY above.
end note

deactivate engine

