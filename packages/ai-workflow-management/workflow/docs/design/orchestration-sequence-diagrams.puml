title Full Orchestration Lifecycle — SYNC vs ASYNC\n<size:10><color:#354A5F>Dark = SYNC (same process, blocking)</color> | <color:#BB0000>Red = ASYNC via OrchestrationQueue</color> | <color:#E9730C>Orange = ASYNC via Messaging Bus + HTTP</color> | <color:#7C5CCC>Purple = User action</color></size>

actor "API Client" as api
participant "StartRunUseCase /\nCompleteTaskUseCase /\nResumePendingUseCase" as usecase SAP_BLUE

box "Orchestration Queue\n(single queue, single consumer)" #FFEEEE
  participant "OrchestrationQueue\n(Memory / Kafka)" as queue SAP_RED
  participant "OrchestrationWorker" as worker SAP_RED
end box

participant "OrchestrationEngine" as engine SAP_BLUE
participant "NodeHandler\n(13 handlers)" as handler SAP_GREEN

box "External Systems" #FFF5E0
  participant "Messaging Bus\n(Kafka / EventMesh)" as bus SAP_GOLD
  participant "WorkerExecutor\n(port 8004)" as executor SAP_GOLD
  participant "Worker\n(HTTP/Agent/Wait)" as extworker SAP_GOLD
end box

actor "User" as user

== 1. API starts a run ==

api -> usecase : POST /start-run
activate usecase
usecase -> usecase : Create WorkflowRun\nValidate, prepare DAG
usecase -[#BB0000]> queue : enqueue(StartRunAction)
usecase --> api : 202 { run_id }
deactivate usecase

note over queue #FFF0E0
  **ASYNC BOUNDARY**
  API returned. Run is "RUNNING"
  but no node has executed yet.
end note

== 2. Engine processes entry nodes ==

... OrchestrationWorker dequeues ...

worker -[#BB0000]>> queue : dequeue()
activate worker
queue --> worker : StartRunAction

worker -> engine : orchestrate_start(run_id)
activate engine

engine -> engine : handle_entry_nodes()

note over engine
  Engine looks at each entry node
  and routes by type. Let's say
  entry node is a **TRIGGER** (BUILTIN).
end note

engine -> handler : invoke_handler(TRIGGER)
activate handler
handler --> engine : NodeHandlerResult(successors=[CONDITION_1])
deactivate handler
engine -> engine : Mark TRIGGER completed

engine -[#BB0000]> queue : enqueue(ExecuteNodeAction(CONDITION_1))
note right of queue #FFF0E0
  Successor is NOT executed now.
  It goes back to the queue.
end note

deactivate engine
deactivate worker

== 3. Engine processes BUILTIN node (CONDITION) ==

... OrchestrationWorker dequeues ...

worker -[#BB0000]>> queue : dequeue()
activate worker
queue --> worker : ExecuteNodeAction(CONDITION_1)

worker -> engine : orchestrate_execute_node(CONDITION_1)
activate engine

engine -> engine : _exec_builtin_queued()

engine -> handler : invoke_handler(CONDITION)
activate handler
note over handler
  **SYNC** — evaluates expression
  against run.context.variables.
  Determines: true branch taken,
  false branch skipped.
end note
handler --> engine : NodeHandlerResult\n(successors=[HTTP_TASK_1],\nskipped=[COMPUTE_2])
deactivate handler

engine -> engine : Mark CONDITION completed\nCascade-skip false branch

engine -[#BB0000]> queue : enqueue(ExecuteNodeAction(HTTP_TASK_1))

engine -> engine : check_run_completion()

deactivate engine
deactivate worker

== 4. Engine processes TASK node (dispatches to external worker) ==

... OrchestrationWorker dequeues ...

worker -[#BB0000]>> queue : dequeue()
activate worker
queue --> worker : ExecuteNodeAction(HTTP_TASK_1)

worker -> engine : orchestrate_execute_node(HTTP_TASK_1)
activate engine

engine -> engine : _exec_task_queued()
engine -> engine : Resolve input variables
engine -> engine : Mark task RUNNING

engine -[#E9730C]> bus : publish task.dispatched\n(contains resolved_input,\nworker_type, task_id)
note right of bus #FFF0E0
  **DIFFERENT ASYNC MECHANISM**
  This does NOT go to OrchestrationQueue.
  It goes to the **Messaging Bus**
  (Kafka / EventMesh / Console).
  The WorkerExecutor service (port 8004)
  is subscribed to this topic.
end note

deactivate engine
deactivate worker

note over engine #FFF0E0
  **Engine is DONE with this node.**
  It will NOT touch this task again
  until the worker calls back with
  the result. Engine is free to
  process other queue actions.
end note

== 5. External worker executes (separate service, separate process) ==

... WorkerExecutor picks up task from messaging bus ...

bus -[#E9730C]>> executor : consume task.dispatched
activate executor

executor -> extworker : POST /api/v1/execute
activate extworker
note over extworker
  **External execution**
  (milliseconds to hours)
  HTTP request, AI agent call,
  wait timer, data mapping...
end note
extworker --> executor : result { output }
deactivate extworker

executor -[#E9730C]> usecase : POST /complete-task\n(run_id, task_id, output)\n**[HTTP callback to control plane]**
deactivate executor

== 6. Completion triggers successor calculation ==

activate usecase
usecase -> usecase : Mark task COMPLETED\nStore output, update variables
usecase -> usecase : maybe_enqueue_loop_iteration()

usecase -[#BB0000]> queue : enqueue(ContinueRunAction)
note right of queue #FFF0E0
  **Back to OrchestrationQueue.**
  Engine will calculate successors
  in the next worker cycle.
end note

deactivate usecase

== 7. Engine calculates and dispatches next node ==

... OrchestrationWorker dequeues ...

worker -[#BB0000]>> queue : dequeue()
activate worker
queue --> worker : ContinueRunAction

worker -> engine : orchestrate_continue(run_id, task_id)
activate engine

engine -> engine : process_and_dispatch_successors()

note over engine
  **SYNC** — SuccessorProcessor walks
  edges, evaluates CONDITION/SWITCH
  inline, cascade-skips, creates tasks.
end note

alt Next node is BUILTIN
  engine -[#BB0000]> queue : enqueue(ExecuteNodeAction(next))\n  -> back to step 3
else Next node is TASK
  engine -[#BB0000]> queue : enqueue(ExecuteNodeAction(next))\n  -> back to step 4
else Next node is PENDING (INPUT)
  engine -> engine : _exec_pending_queued()\nSave PENDING task, publish events
  note over engine #FFF0E0
    **Run PAUSES.**
    No more queue actions.
    Waiting for user.
  end note
else No more successors (leaf reached)
  engine -> engine : check_run_completion()\n  -> Run status = COMPLETED
end

deactivate engine
deactivate worker

== 8. (If PENDING) User submits input ==

