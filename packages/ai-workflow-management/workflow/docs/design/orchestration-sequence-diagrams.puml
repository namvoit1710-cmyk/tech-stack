title CONDITION / SWITCH Branching\n<size:10>**Entire flow is SYNCHRONOUS** — evaluation + skip cascade + dispatch in one call stack</size>

participant "SuccessorProcessor" as sp SAP_BLUE
participant "ConditionNodeHandler" as handler SAP_GREEN
participant "ConditionEvaluator" as eval SAP_GREEN
participant "VariableResolver" as vr SAP_GREEN
participant "compute_fanout" as fanout SAP_TEAL
participant "TaskFactory" as tf SAP_TEAL
participant "EventPublisher" as pub SAP_NAVY

== SYNC: All within SuccessorProcessor.process() ==

sp -> sp : process(completed_task, run, ...)
activate sp

sp -> sp : Source is CONDITION\n  -> _evaluate_branching_node()

sp -> handler : invoke_handler(node, run, ...)
activate handler

handler -> eval : evaluate(expression, run.context)
activate eval

eval -> vr : resolve(operands)\n  e.g. $.previous_node.status
activate vr
vr --> eval : resolved values
deactivate vr

eval --> handler : true / false
deactivate eval

handler -> handler : Set taken_edge_ports\n  (e.g. {"condition_true": "out_true"})
handler -> handler : Emit EdgeTraversed\n  for taken branch\n  **[handler emits its own edges —\n  engine skips edge emission for\n  CONDITION/SWITCH types]**

handler --> sp : NodeHandlerResult\n  (taken_edge_ports, skipped_node_ids)
deactivate handler

sp -> fanout : compute_fanout(edges, taken_ports, ...)\n  -> FanoutAction for taken branch\n  -> SkipAction for untaken branch
activate fanout
fanout --> sp : FanoutDecision
deactivate fanout

== SYNC: Skip Propagation (BFS cascade) ==

group SYNC skip cascade [For each untaken branch]
  sp -> sp : BFS collect_downstream_nodes_to_skip()\n  **[SYNC — walks DAG; only skips if\n  ALL predecessors are skipped;\n  merge-point nodes with live\n  incoming paths stay active]**

  loop For each skipped node
    sp -> pub : TaskSkipped event\n  (deterministic event_id)
    activate pub
    deactivate pub
  end
end

== SYNC: Taken Branch Dispatch ==

sp -> tf : create_task(taken_target_node, run)\n  **[SYNC — inherits scope_stack\n  from contextvar if set]**
activate tf
tf --> sp : task
deactivate tf

sp -> sp : Continue processing taken branch\n  (may recurse into next BUILTIN)

deactivate sp

