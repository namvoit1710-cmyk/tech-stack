    ArrowFontSize 10
    LifeLineBorderColor SAP_GRAY_MEDIUM
    LifeLineBackgroundColor SAP_GRAY_LIGHT
    BoxBackgroundColor SAP_WHITE
    BoxBorderColor SAP_GRAY_LIGHT
    DividerBackgroundColor SAP_GRAY_LIGHT
    DividerBorderColor SAP_GRAY_MEDIUM
    GroupBackgroundColor SAP_WHITE
