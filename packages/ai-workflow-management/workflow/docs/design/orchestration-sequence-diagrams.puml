title BUILTIN Node — Inline Mode (CONDITION, SWITCH, COMPUTE, MERGE, PARALLEL, TRIGGER)\n<size:10>**Entire flow is SYNCHRONOUS** — single recursive call stack, no queue involved</size>

participant "OrchestrationEngine" as engine SAP_BLUE
participant "NodeHandler" as handler SAP_GREEN
participant "TaskFactory" as tf SAP_TEAL
participant "EventPublisher" as pub SAP_NAVY

== SYNC: All within dispatch_or_handle_task (recursive, max depth 100) ==

engine -> engine : dispatch_or_handle_task(task)
activate engine

engine -> engine : Buffer task.dispatched event\n(EventCollector, not yet published)

engine -> handler : invoke_handler(node, run, ...,\ncurrent_scope_stack=task.scope_stack)
activate handler
note over handler
  **SYNC** — handler runs inline.
  scope_stack contextvar set before call,
  reset in finally block after call.
  Handler reads run.context, evaluates
  expressions, returns result.
end note
handler --> engine : NodeHandlerResult\n(tasks, events, state_updates,\ntaken_edge_ports)
deactivate handler

engine -> engine : Apply state_updates\n  -> run.context.variables
engine -> engine : Apply loop_state_updates\n  -> run.context.loop_state
engine -> engine : Mark task COMPLETED
engine -> engine : Buffer task.completed event

engine -> pub : emit edge.traversed events\n(published IMMEDIATELY, not buffered)
activate pub
deactivate pub

group SYNC recursion [For each successor task from handler result]
  engine -> engine : dispatch_or_handle_task(successor)\n**[SYNC recursive call, same stack]**
  note right of engine
    Successor may be BUILTIN (recurse again),
    PENDING (save + pause), or TASK (dispatch).
    Max recursion depth = 100.
  end note
end

engine -> engine : drain_events()\n  IMMEDIATE -> NORMAL -> TERMINAL\n  (publishes all buffered events)

deactivate engine

@enduml


