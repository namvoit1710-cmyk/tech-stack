title PENDING Node — INPUT / HUMAN_ACTION / DATA_EDIT / FILE_UPLOAD\n<size:10><color:#BB0000>Red = ASYNC</color> | <color:#7C5CCC>Purple = USER ACTION (unbounded wait)</color> | <color:#354A5F>Dark = SYNC</color></size>

participant "OrchestrationEngine" as engine SAP_BLUE
participant "NodeHandler" as handler SAP_GREEN
participant "TaskRepo" as repo SAP_TEAL
participant "EventPublisher" as pub SAP_NAVY
actor "User" as user
