title LOOP Node — Event-Driven, Inline Mode (EVENT_DRIVEN_LOOP=true, queue=None)\n<size:10>**Entire flow is SYNCHRONOUS** — driver.run_loop drives all iterations in one call stack</size>

participant "OrchestrationEngine" as engine SAP_BLUE
participant "EventDrivenLoopDriver" as driver SAP_GREEN
participant "EventPublisher" as pub SAP_NAVY

== SYNC: All within dispatch_or_handle_task → driver.run_loop ==

engine -> engine : dispatch_or_handle_task(task)\n[LOOP + driver, queue=None]
activate engine

engine -> engine : Mark loop task COMPLETED
engine -> engine : Buffer task.completed event

engine -> driver : run_loop(loop_node, loop_task, run, ...)\n**[SYNC call — driver drives entire loop]**
activate driver

driver -> driver : initialize_loop()\n  Resolve items, build loop_state,\n  derive invocation_id

driver -> pub : LoopStarted (SYNC publish via inject)
activate pub
deactivate pub

driver -> pub : LoopIterationStarted(iter=0) (SYNC)
activate pub
deactivate pub

group SYNC iteration loop [While iterations remain AND NOT break_requested]

  driver -> driver : _dispatch_iteration_body(iter=N)\n  Set task.scope_stack =\n  [LoopScope(iter=N, invocation_id=...)]

  driver -> engine : enqueue_or_dispatch(body_task)\n**[SYNC — falls through to\ndispatch_or_handle_task recursively]**
  note over engine
    **SYNC recursion** — body task
    executes inline (BUILTIN handlers
    recurse, TASK nodes dispatch to
    workers, PENDING nodes pause).
    When this call returns, body is done.
  end note

  driver -> pub : LoopIterationCompleted(iter=N) (SYNC)
  activate pub
  deactivate pub

  driver -> driver : Check break_requested\n  Re-evaluate condition (if condition loop)

  driver -> pub : LoopIterationStarted(iter=N+1) (SYNC)
  activate pub
  deactivate pub

end

driver -> pub : LoopCompleted(reason) (SYNC)
activate pub
deactivate pub

driver -> engine : enqueue_or_dispatch(exit_task)\n**[SYNC — exit task dispatched inline]**

deactivate driver

engine -> engine : Save run
engine -> engine : drain_events()

deactivate engine

@enduml


