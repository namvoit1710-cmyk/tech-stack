title LOOP Node — Event-Driven, Queued Mode (EVENT_DRIVEN_LOOP=true, queue!=None)\n<size:10><color:#BB0000>Red = ASYNC (queue handoff)</color> | <color:#354A5F>Dark = SYNC</color> — **Each iteration is a separate ASYNC cycle**</size>

participant "OrchestrationWorker" as worker SAP_RED
participant "OrchestrationQueue" as queue SAP_RED
participant "OrchestrationEngine" as engine SAP_BLUE
participant "EventDrivenLoopDriver" as driver SAP_GREEN
participant "LoopNodeHandler" as handler SAP_GREEN
participant "EventPublisher" as pub SAP_NAVY

== SYNC: Loop Initialization (engine call stack) ==

engine -> engine : dispatch_or_handle_task(task)\n[LOOP + driver + queue]
activate engine

engine -> engine : Mark loop task COMPLETED

engine -> driver : initialize_loop_queued(...)\n**[SYNC call]**
activate driver

driver -> driver : initialize_loop()\n  Resolve items, build loop_state
driver -> driver : Init iter_progress = {} on loop_state

driver -> pub : LoopStarted + LoopIterationStarted(0)
activate pub
deactivate pub

driver -[#BB0000]> queue : enqueue(ExecuteNodeAction)\n  [body task 0]\n**[ASYNC: body runs later]**
activate queue
deactivate queue

deactivate driver

engine -> engine : Save run

note over engine #FFF0E0
  **Engine RETURNS here.**
  Loop initialization is done.
  Body task 0 will be processed
  asynchronously by the worker.
end note

deactivate engine

== ~~~ ASYNC BOUNDARY ~~~ (body task 0 processed by worker) ==

... Worker dequeues and processes body task 0 ...
... (could be BUILTIN, TASK, or PENDING — see other diagrams) ...

== SYNC: Body Completion Hook (runs at end of body task processing) ==

engine -> engine : maybe_enqueue_loop_iteration\n  (completed_task, run)
activate engine

note over engine
  **SYNC gate checks:**
  1. queue != None? yes
  2. driver != None? yes
  3. task.scope_stack has invocation_id? yes
  4. Loop is active? yes
end note

engine -> engine : Record node_id in iter_progress[0]
engine -> engine : Sweep skipped_nodes into progress
engine -> engine : is_iteration_done() — runtime BFS\n  (SYNC — walks dag_info.edge_map)

alt BFS says iteration 0 is complete
  engine -[#BB0000]> queue : enqueue(LoopIterationAction)\n**[ASYNC: iteration boundary\nprocessed in next worker cycle]**
  activate queue
  deactivate queue
else Still waiting for more body nodes
  note over engine
    No action. Hook will fire again
    when next body node completes.
  end note
end

deactivate engine

== ~~~ ASYNC BOUNDARY ~~~ (iteration boundary) ==

... Worker dequeues LoopIterationAction ...

worker -[#BB0000]>> queue : dequeue()
activate worker
activate queue
queue --> worker : LoopIterationAction\n(run_id, task_id, loop_node_id, iter=0)
deactivate queue

== SYNC: Iteration Boundary Processing (under run lock) ==

worker -> engine : orchestrate_loop_iteration(...)
activate engine

engine -> engine : Acquire run lock
engine -> engine : Build synthetic completed task\n  (represents iteration 0 result)
engine -> engine : Reconstruct scope_stack from loop_state

engine -> handler : invoke_handler(iteration_complete)\n**[SYNC — delegates to driver]**
activate handler
handler -> driver : driver.iteration_complete()
activate driver
driver --> handler : NodeHandlerResult\n  (events, next body tasks or exit)
deactivate driver
handler --> engine : NodeHandlerResult
deactivate handler

engine -> engine : Apply loop_state_updates

== SYNC: Iter-boundary cleanup ==

engine -> engine : iter_progress.pop(0)\n  (drop finished iteration bucket)

alt More iterations (completed < total)
  engine -> engine : iter_progress[1] = []\n  (init next iteration bucket)
  engine -> engine : BFS iterate_body_subgraph()\n  Wipe body nodes from\n  completed_nodes + skipped_nodes\n  **[SYNC — enables re-execution]**

  engine -[#BB0000]> queue : enqueue(ExecuteNodeAction)\n  [next body task]\n**[ASYNC: next iteration starts]**
  activate queue
  deactivate queue
else All iterations done (or break)
  engine -> pub : LoopCompleted(reason) (SYNC)
  activate pub
  deactivate pub

  engine -[#BB0000]> queue : enqueue(ExecuteNodeAction)\n  [exit task]\n**[ASYNC: post-loop continues]**
  activate queue
  deactivate queue
end

engine -> engine : Save run
engine -> engine : check_run_completion()

deactivate engine
deactivate worker

@enduml


