@startuml runtime_credential_provider
'==============================================================================
' Runtime Credential Provider — design diagram
'------------------------------------------------------------------------------
' Purpose: document how run-time credentials (supplied by the UI / Agent at
' StartRun, or by a stored provider) are transported, stored (encrypted),
' exposed as a new $credentials scope, delivered to worker tasks, and coalesced
' per-node against any credential the author set explicitly on the node.
'
' Generalised for many auth "shapes" — credentials are SELF-DESCRIBING and
' keyed by name, materialised in ONE place (AuthType + materialize_auth_header):
'
'   $credentials.<name> = { "type": "bearer",         "config": { token } }
'                         { "type": "basic",          "config": { username, password } }
'                         { "type": "api_key_header", "config": { header, value } }
'                         { "type": "oauth_cc",       "config": { token_url, client_id, client_secret } }
'
' Behaviour contract (per auth-capable worker node):
'   node credential set        -> use NODE credential        (author wins)
'   node empty, provider has it -> borrow $credentials[ref]   (ref defaults "default")
'   auth enabled AND both empty -> FAIL (raise ValueError)
'   auth_type == none           -> no auth, runtime credential ignored
'
' Security: $credentials encrypted at-rest via ICredentialCipher and redacted
' from logs, NodeInput events, variable-suggestions samples, emit_variables_seeded.
'
' Styling: SAP brand palette — consistent with input_data_sequence.puml.
'==============================================================================

!define SAP_GOLD #F0AB00
!define SAP_DARK_BLUE #354A5F
!define SAP_BLUE #0A6ED1
!define SAP_LIGHT_BLUE #EBF8FF
!define SAP_GREEN #107E3E
!define SAP_RED #BB0000
!define SAP_YELLOW #E9730C
!define SAP_GRAY #6A6D70
!define SAP_LIGHT_GRAY #EDEFF0
!define SAP_TEXT #32363A
!define SAP_WHITE #FFFFFF

skinparam backgroundColor SAP_WHITE
skinparam defaultFontName "72", "SAP 72", "Segoe UI", Arial, sans-serif
skinparam defaultFontColor SAP_TEXT
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8

skinparam sequence {
    ArrowColor SAP_DARK_BLUE
    ArrowFontColor SAP_TEXT
    ActorBorderColor SAP_DARK_BLUE
    ActorBackgroundColor SAP_LIGHT_BLUE
    ActorFontColor SAP_TEXT
    ParticipantBorderColor SAP_BLUE
    ParticipantBackgroundColor SAP_BLUE
    ParticipantFontColor SAP_WHITE
    LifeLineBorderColor SAP_GRAY
    LifeLineBackgroundColor SAP_LIGHT_GRAY
    BoxBorderColor SAP_DARK_BLUE
    BoxBackgroundColor SAP_LIGHT_BLUE
    DividerBorderColor SAP_GOLD
    DividerBackgroundColor SAP_GOLD
    DividerFontColor SAP_TEXT
    GroupBorderColor SAP_DARK_BLUE
    GroupBackgroundColor SAP_LIGHT_BLUE
    GroupHeaderFontColor SAP_WHITE
    NoteBackgroundColor SAP_LIGHT_GRAY
    NoteBorderColor SAP_GRAY
    NoteFontColor SAP_TEXT
}

title Runtime Credential Provider — named map, $credentials scope, type-aware coalesce

actor "UI / Agent" as FE
participant "REST Controller\n(run_controller.py)\nStartRunRequest" as CTRL
participant "StartRunUseCase\n(start_run_use_case.py)" as SR
participant "ICredentialCipher\n(encrypt/decrypt)" as CIP
participant "ICredentialProvider\nP1: static run\nP2: gateway store / OAuth" as PROV
participant "Run Repository\n(+ snapshot)" as RR
participant "Orchestration\nEngine" as ENG
participant "ResolutionScopeBuilder\n+ SystemCredentialsFrame" as SCOPE
participant "TaskHandler\n(task_handler.py)" as TH
participant "Event Log\n+ Projector" as PROJ
participant "Worker + worker-sdk helper\n(materialize_auth_header)" as WK

note over FE, CTRL
  StartRunRequest gains a NAMED MAP of
  self-describing credentials:
    runtime_credentials: {
      "default": { type:"bearer", config:{ token } },
      "crm":     { type:"basic",  config:{ username, password } }
    }
end note

== 1. StartRun — transport + encrypt + seed ==

FE -> CTRL : POST /runs\n{ workflow_id, input_data,\n  runtime_credentials:{ name -> {type,config} } }
CTRL -> SR : execute(req incl. runtime_credentials)
activate SR
SR -> CIP : encrypt(runtime_credentials)
CIP --> SR : EncryptedCredential\n(ciphertext_b64, key_version)
SR -> SR : RunContext.variables["__credentials"] = EncryptedCredential
note right of SR
  Reserved key "__credentials" — stored
  ENCRYPTED, never plaintext at-rest.
end note
SR -> RR : asave(run)   ' snapshot holds ciphertext only
SR -> PROJ : emit_variables_seeded(variables)\n** "__credentials" REDACTED **
deactivate SR
CTRL --> FE : 202 run started

== 2. Build resolution scope ($credentials) ==

ENG -> SCOPE : build(run, workflow)
activate SCOPE
SCOPE -> CIP : decrypt(variables["__credentials"])
CIP --> SCOPE : { name -> {type, config} }
SCOPE -> SCOPE : frames += SystemCredentialsFrame(view)
note right of SCOPE
  One new frame class + one builder line —
  exactly as resolution_scope.py anticipated
  ($secret / $env / $tenant).
  Reserved source: "credentials".
  {{$credentials.<name>}} now resolves.
end note
SCOPE --> ENG : ResolutionScope
deactivate SCOPE

== 3. Dispatch worker node — inject credential map ==

ENG -> TH : handle(node, run, workflow)
activate TH
TH -> TH : resolve input_binding\n(node-author values incl. credential_ref, any explicit creds)
alt run has __credentials AND node is a worker node
  TH -> SCOPE : lookup("credentials")
  SCOPE --> TH : decrypted credential map
  TH -> TH : resolved_input["__credentials"] = map
end
TH -> PROJ : emit NodeInput(resolved_input)\n** "__credentials" REDACTED in event **
TH --> ENG : NodeHandlerResult (task -> dispatch)
deactivate TH

== 4. Worker — pick + coalesce + materialize (type-aware) ==

ENG -> WK : ExecuteRequest(inputs incl. __credentials, credential_ref)
activate WK
WK -> WK : resolve_effective_auth(inputs)
note right of WK
  Shared worker-sdk helper:
   1. node credential set?  -> use NODE
   2. else name = credential_ref or "default"
      cred = inputs.__credentials[name]
   3. materialize by cred.type
      (header workers -> materialize_auth_header;
       DB workers -> raw config)
  Adding an auth type = extend ONE function.
end note

alt auth_type == none
  WK -> WK : no auth (runtime credential ignored)
else node credential set (author override — e.g. other account)
  WK -> WK : materialize NODE credential by its type
else node empty, provider entry [credential_ref] present
  WK -> WK : materialize PROVIDER credential by its type\n(bearer / basic / api_key_header / oauth_cc*)
else auth enabled, both empty
  WK -> WK : raise ValueError ("credential required ...")
  WK --> ENG : TaskStatus.ERROR
end

WK -> WK : send HTTP / connect with effective auth
WK --> ENG : ExecuteTaskResult (outputs, status)
deactivate WK

== 5. Variable suggestions (UI discoverability) ==

FE -> CTRL : GET /runs/{id}/nodes/{nid}/variable-suggestions
CTRL -> CTRL : CredentialsScopeProvider.build(...)
note right of CTRL
  Emits {{$credentials.<name>}} cards for
  autocomplete — NEVER sets `sample`
  (no plaintext credential leaks to the FE).
end note
CTRL --> FE : scopes[] incl. "credentials" (names only, no samples)

== Provider sources (ICredentialProvider) ==

note over PROV
  P1 (now): StaticRunCredentialProvider — reads decrypted "__credentials".
  P2 (later): gateway-app stored credentials (reuse encrypted store via
             resolve_gateway_function); OAuth client-credentials with refresh
             — implement oauth_cc in materialize_auth_header (currently NotImplemented).
  Worker-sdk helper calls the provider, so the SOURCE can change without
  touching workers.
end note

== Invariants ==

note over RR, PROJ
  * At-rest: only EncryptedCredential is persisted (run + snapshot).
  * In-flight: plaintext under reserved "__credentials"; redacted from
    NodeInput events, logs and emit_variables_seeded.
  * Self-describing: each credential carries its own type+config; materialised
    in one place -> any auth shape is added without per-worker churn.
  * Named: multiple distinct identities per run via credential_ref.
  * Author wins; fail-closed (auth on + no credential anywhere -> error).
end note

footer Runtime Credential Provider — workflow-control-plane-service

@enduml
