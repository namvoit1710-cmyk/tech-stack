        { "id": "l1-switch", "name": "L1-SWITCH", "node_type": "SWITCH", "config": { "data": [ { "key": "{{$l1-ha._action}}", "operations": "==", "value": "confirm", "branch": "go" } ] } },
        { "id": "l1-rej", "name": "L1-REJ", "node_type": "OUTPUT", "config": { "output_schema": [ { "key": "deepest", "type": "string", "value": "rejected" }, { "key": "status", "type": "string", "value": "rejected" } ] } },
        { "id": "l1-side", "name": "L1-SIDE", "node_type": "OUTPUT", "config": { "output_schema": [ { "key": "deepest", "type": "string", "value": "side" }, { "key": "status", "type": "string", "value": "side" } ] } },
        { "id": "l1-wf", "name": "L1-CALL-L2", "node_type": "WORKFLOW", "config": { "workflow_id": "wf-l2", "input_mapping": {}, "on_failure": "fail" } },
        { "id": "l1-out", "name": "L1-OUT", "node_type": "OUTPUT", "config": { "output_schema": [ { "key": "deepest", "type": "string", "value": "{{$l1-wf.output.deepest}}" }, { "key": "level1", "type": "number", "value": "{{$l1-compute.output.result}}" } ] } }
      ],
      "edges": [
        { "source_node_id": "l1-trig", "target_node_id": "l1-ha" },
        { "source_node_id": "l1-ha", "target_node_id": "l1-cond" },
        { "source_node_id": "l1-cond", "target_node_id": "l1-biz", "source_port_id": "true_branch" },
        { "source_node_id": "l1-cond", "target_node_id": "l1-rej", "source_port_id": "false_branch" },
        { "source_node_id": "l1-biz", "target_node_id": "l1-compute" },
        { "source_node_id": "l1-compute", "target_node_id": "l1-switch" },
        { "source_node_id": "l1-switch", "target_node_id": "l1-wf", "source_port_id": "go" },
        { "source_node_id": "l1-switch", "target_node_id": "l1-side", "source_port_id": "default" },
        { "source_node_id": "l1-wf", "target_node_id": "l1-out" }
      ]
