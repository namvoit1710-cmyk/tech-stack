{
  "_comment": "5-level nested sub-workflow bundle with custom (NodeDefinition) nodes. Mirror of tests/integration/test_nested_child_workflows_5layer_custom_nodes.py. Per level: HUMAN_ACTION -> CONDITION -> custom TASK -> COMPUTE -> SWITCH -> WORKFLOW(next) -> OUTPUT, plus reject/side OUTPUT leaves. The test seeds these with EXPLICIT workflow ids (wf-l1..wf-l5) via repo.save + stamps definition_snapshot with the production NodeDefinitionResolver. Over the public API the WORKFLOW node references children by workflow_id, so create bottom-up (wf-l5 first) and substitute each generated id into the parent's config.workflow_id. The custom node's base_worker_id ('biz-worker') is a placeholder; for a LIVE run point it at a registered worker (e.g. 'http_request') and adjust locked_defaults/input_mapping accordingly.",

  "node_definitions": [
    {
      "id": "nd-business",
      "tenant_id": "t1",
      "name": "Business Step",
      "base_type": "TASK",
      "base_worker_id": "biz-worker",
      "data_mode": "json",
      "edit_mode": "none",
      "locked_defaults": { "method": "POST" },
      "input_mapping": { "payload": "{{$custom.note}}" },
      "output_mapping": {
        "summary": "{{$_output.status_code}}",
        "tag": "{{$_output.tag}}"
      },
      "input_schema": [ { "key": "note", "outputType": "string" } ],
      "output_schema": [
        { "key": "summary", "outputType": "number" },
        { "key": "tag", "outputType": "string" }
      ]
    },
    {
      "id": "nd-business-l5",
      "tenant_id": "t1",
      "name": "Business Step (L5)",
      "base_type": "TASK",
      "parent_definition_id": "nd-business",
      "locked_defaults": { "method": "PATCH" }
    }
  ],

  "workflows": [
    {
      "id": "wf-l1",
