title **1. Start Run — Async via Queue**

actor Client
participant "RunController" as RC
participant "StartRunUseCase" as UC
database "Repos\n(Run/Workflow)" as RR
participant "StageRecorder" as SR
participant "EventPublisher" as EP
queue "OrchestrationQueue\n(Kafka / Memory)" as Q $ASYNC
participant "OrchestrationWorker" as OW $ASYNC
participant "OrchestrationEngine" as OE $ASYNC
participant "NodeHandler" as NH $ASYNC
participant "WorkerExecutor\n(External)" as WE $ASYNC

== Synchronous — HTTP Request ==

Client -> RC : POST /api/runs\n{workflow_id, input_data}
activate RC
RC -> UC : execute(StartRunCommand)
activate UC

UC -> RR : get_workflow(id) + DAGValidator.validate()
UC -> RR : create WorkflowRun(PENDING)\nseed context: input, workflow, run metadata
UC -> RR : run.status = RUNNING, save(run)
UC -> SR : record("run.created")\nrecord("run.started")
UC -> EP : publish(**RunStarted**)
UC -[#F0AB00]> Q : enqueue(**StartRunAction**(run_id))

UC --> RC : StartRunResult(id, status="RUNNING")
deactivate UC
RC --> Client : **200 OK** {run_id, status: "RUNNING"}
deactivate RC

note over Client : Response returned **immediately**\nNo waiting for orchestration

== Asynchronous — Background Worker ==

Q -[#F0AB00]> OW : dequeue() -> StartRunAction
activate OW
OW -> OE : orchestrate_start(run_id)
activate OE

OE -> RR : load run, workflow, dag_info
OE -> OE : handle_entry_nodes()

loop for each reachable node (recursive)
  OE -> NH : handle(node, run, dag_info, ...)

  alt **BUILTIN** (Condition, Switch, Parallel, Merge, Loop, Compute, Trigger)
    NH --> OE : NodeHandlerResult
    OE -> OE : execute inline, mark completed\nrecurse enqueue ExecuteNodeAction → _exec_uniform()
  else **TASK**
    NH --> OE : Task(status=RUNNING)
    OE -> EP : publish(**TaskDispatched**)
    OE -[#999999]> WE : dispatch task (fire & forget)
    note right : Awaits worker callback\n(separate HTTP request)
  else **PENDING** (Input, HumanAction, FileUpload, DataEdit)
    NH --> OE : Task(status=PENDING)
    OE -> RR : save(pending_task)
    OE -> EP : publish(**InputRequested**)
    note right #FFE0B2 : Workflow **pauses**\non this branch
  end
end

OE -> OE : check_run_completion()
OE -> RR : save(run)
deactivate OE
deactivate OW

@enduml

