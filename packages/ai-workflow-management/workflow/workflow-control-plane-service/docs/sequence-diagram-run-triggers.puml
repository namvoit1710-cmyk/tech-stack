title **3. Resume Pending Task — User Input (Async via Queue)**

actor Client
participant "RunController" as RC
participant "ResumePendingTask\nUseCase" as UC
database "Repos\n(Task/Run)" as RR
participant "DataStoreService" as DS
participant "StageRecorder" as SR
participant "EventPublisher" as EP
queue "OrchestrationQueue" as Q $ASYNC
participant "OrchestrationWorker" as OW $ASYNC
participant "OrchestrationEngine" as OE $ASYNC

== Synchronous — HTTP Request ==

Client -> RC : POST /runs/{run_id}/tasks/{task_id}/resume\n{updated_input: {name: "Alice", ...}}
activate RC
RC -> UC : execute(ResumePendingTaskCommand)
activate UC

UC -> RR : load run, task (status=PENDING), workflow, node
UC -> UC : merge updated_input into task.resolved_input
UC -> UC : task.status = COMPLETED

opt HUMAN_ACTION node
  UC -> UC : extract action (confirm/reject)
  UC -> UC : apply branching: skip not-taken branch\nand all downstream nodes
end

UC -> DS : store submitted_data as CSV -> file_ref
UC -> RR : run.context.variables[node_id] = file_ref\nadd node to completed_nodes
UC -> RR : save(task), save(run)
UC -> SR : record("task.resumed")
UC -[#F0AB00]> Q : enqueue(**ResumeTaskAction**(run_id, task_id))
UC -> EP : publish(**InputSubmitted** / **HumanActionCompleted**)
UC --> RC : {resumed: true, status: "COMPLETED"}
deactivate UC
RC --> Client : **200 OK**
deactivate RC

== Asynchronous — Background Worker ==

Q -[#F0AB00]> OW : dequeue() -> ResumeTaskAction
activate OW
OW -> OE : orchestrate_resume(run_id, task_id)
activate OE
OE -> RR : load run (updated context), task, workflow
OE -> OE : process_successors(completed_task)
OE -> OE : enqueue ExecuteNodeAction → _exec_uniform() for each successor
OE -> OE : check_run_completion()
OE -> RR : save(run)
deactivate OE
deactivate OW

@enduml

