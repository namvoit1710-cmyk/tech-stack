title **5. Test Single Node — Synchronous (No Queue)**

actor Client
participant "RunController" as RC
participant "TestNodeUseCase" as UC
database "Repos\n(Run/Workflow)" as RR
participant "NodeHandler" as NH
participant "OrchestrationEngine" as OE
participant "WorkerExecutor\n(External)" as WE

note over UC : No orchestration queue\nSingle node only — **no successor processing**

Client -> RC : POST /workflows/{id}/nodes/{node_id}/test\n{input_data, mock_variables}
activate RC
RC -> UC : execute(TestNodeCommand)
activate UC

UC -> RR : load workflow, get node
UC -> RR : get/create test_run (test_mode="node")
UC -> UC : apply input_data + mock_variables\nto run.context.variables

alt **BUILTIN** node (Condition, Switch, Compute...)
  UC -> NH : handle(node, run, ...)
  NH --> UC : NodeHandlerResult\n(output, skipped_branches, events)
  UC -> UC : apply state_updates to context
  UC --> Client : {execution_type: "**builtin**",\noutput, events}

else **TASK** node
  UC -> NH : handle(node, run, ...)
  NH --> UC : Task with resolved_input
  UC -> OE : enqueue ExecuteNodeAction → _exec_uniform()
  OE -[#999999]> WE : dispatch task to worker
  note right : **No successor processing**\n(test_mode="node")
  UC --> Client : {execution_type: "**task**",\ntask_id, resolved_input, worker_type}

else **PENDING** node (Input, HumanAction, FileUpload)
  UC -> NH : handle(node, run, ...)
  NH --> UC : Task(PENDING)\n+ input_schema, instruction, prefilled
  UC --> Client : {execution_type: "**pending**",\ninput_schema, instruction, prefilled}
end

deactivate UC
deactivate RC

@enduml
