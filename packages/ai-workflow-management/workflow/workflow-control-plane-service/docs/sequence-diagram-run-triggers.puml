title **2. Complete Task — Worker Callback (Async via Queue)**

participant "WorkerExecutor\n(External)" as WE
participant "RunController" as RC
participant "CompleteTaskUseCase" as UC
database "Repos\n(Task/Run)" as RR
participant "DataStoreService" as DS
participant "StageRecorder" as SR
participant "EventPublisher" as EP
queue "OrchestrationQueue" as Q $ASYNC
participant "OrchestrationWorker" as OW $ASYNC
participant "OrchestrationEngine" as OE $ASYNC

== Synchronous — HTTP Request ==

WE -> RC : POST /runs/{run_id}/tasks/{task_id}/complete\n{output_reference, output_metadata}
activate RC
RC -> UC : execute(CompleteTaskCommand)
activate UC

UC -> RR : task.status = COMPLETED\ntask.output_ref, task.completed_at
UC -> SR : record("task.completed")

group Build & store output
  UC -> UC : build task_output envelope
  UC -> UC : apply output_mapping (node definition)
  UC -> UC : apply output_binding (node config)
  UC -> UC : extract _artifacts
  UC -> DS : store_data(node_id, task_output) -> CSV file_ref
  UC -> UC : attach worker artifacts to file_ref
end

UC -> RR : run.context.variables[node_id] = file_ref\nsave(run)
UC -> EP : publish(**TaskCompleted**)
UC -> EP : publish(**ContextUpdated**)
UC -[#F0AB00]> Q : enqueue(**ContinueRunAction**(run_id, task_id))
UC --> RC : {completed: true}
deactivate UC
RC --> WE : **200 OK**
deactivate RC

== Asynchronous — Background Worker ==

Q -[#F0AB00]> OW : dequeue() -> ContinueRunAction
activate OW
OW -> OE : orchestrate_continue(run_id, task_id)
activate OE
OE -> RR : load run (with updated context), task, workflow
OE -> OE : process_successors(completed_task)
OE -> EP : publish(**EdgeTraversed** events)
OE -> OE : enqueue ExecuteNodeAction → _exec_uniform()\nfor each successor
OE -> OE : check_run_completion()
OE -> RR : save(run)
deactivate OE
deactivate OW

@enduml

