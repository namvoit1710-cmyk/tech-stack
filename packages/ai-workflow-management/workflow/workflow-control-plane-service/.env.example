# ════════════════════════════════════════════════════════════════════════════════
# Workflow Control Plane — .env.example
# ════════════════════════════════════════════════════════════════════════════════
# Copy to `.env` and override what you need for your environment.
# Any value commented out uses the in-code default shown in the comment.
#
# Credential priority:
#   1. VCAP_SERVICES JSON (SAP BTP Cloud Foundry)  ← highest
#   2. Individual HANA_* / EVENT_MESH_* env vars   ← fallback
#
# Only set what the INFRA_MODE you pick actually needs. The “mock” mode
# (default) requires NOTHING below except INFRA_MODE itself.
# ════════════════════════════════════════════════════════════════════════════════


# ─── 1. Runtime mode ────────────────────────────────────────────────────────────
# INFRA_MODE selects the repository/messaging/persistence backends.
#   mock    → in-memory repos + console messaging. Zero external deps. (default)
#   sqlite  → in-memory repos, SQLite event log (durable across restart)
#   local   → Kafka messaging + memory repos (local Docker stack)
#   sap     → SAP HANA persistence + SAP Event Mesh messaging (production)
INFRA_MODE=mock

# APP_MODE selects the process entrypoint. Only REST is supported today.
APP_MODE=REST

# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# ─── 2. HTTP / gRPC listeners ───────────────────────────────────────────────────
SERVICE_PORT=8001

# Enable the gRPC controller alongside HTTP.
#   http (default) → HTTP only
#   grpc           → HTTP + gRPC listener on GRPC_PORT
TRANSPORT_MODE=http
GRPC_PORT=50051
GRPC_MAX_WORKERS=10

# CORS for the REST API. Use "*" for dev, explicit origins for prod.
CORS_ORIGINS=*


# ─── 3. Dependent services ──────────────────────────────────────────────────────
# Worker Executor — HTTP + gRPC endpoints. Required in every non-mock mode.
WORKER_EXECUTION_URL=http://localhost:8004
WORKER_EXECUTION_GRPC_TARGET=localhost:50052

# External services the control plane calls out to. Leave empty if unused.
AGENT_SERVICE_URL=
FILE_SERVICE_URL=
DATA_FACTORY_URL=
SCHEMA_TRANSFORM_URL=

# Credentials vault (credentials-management) — run-time credential_ref resolution.
# Setting CREDENTIALS_VAULT_URL activates the StartRun producer that resolves a
# node's credential_ref into the encrypted __credentials map. Leave empty to keep
# it dormant (workers fall back to inline/author-supplied credentials). Requires the
# vault's authenticated GET /api/v1/internal/credentials/:id/resolve endpoint.
CREDENTIALS_VAULT_URL=
CREDENTIALS_VAULT_SERVICE_TOKEN=

# Frontend push gateway. Empty disables push notifications.
#   PUSH_GATEWAY_PROVIDER: grpc (default) | http
PUSH_GATEWAY_URL=
PUSH_GATEWAY_PROVIDER=grpc


# ─── 4. Generic persistence / cache ─────────────────────────────────────────────
# DATABASE_URL is used by BaseSettings but the service persists via HANA in
# `sap` mode and via memory otherwise. Leave default unless you know you need it.
DATABASE_URL=sqlite:///./app.db

# Redis is used by Socket.IO for horizontal scaling (multiple control-plane
# instances). If unreachable, it silently falls back to in-memory single-instance.
REDIS_URL=redis://localhost:6379

# S3 placeholders — reserved for future file-backed features.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ai-workflow


# ─── 5. SAP HANA (INFRA_MODE=sap) ───────────────────────────────────────────────
# You can either provide VCAP_SERVICES (below) OR fill these individual values.
HANA_HOST=
HANA_PORT=443
HANA_USERNAME=
HANA_PASSWORD=
HANA_SCHEMA=
HANA_ENCRYPT=true
HANA_SSL_CERT=

# HDI deployer credentials (used by db/hdi deploy tooling).
HANA_HDI_USERNAME=
HANA_HDI_PASSWORD=

# SQLAlchemy pool tuning.
HANA_POOL_SIZE=5
HANA_MAX_OVERFLOW=10
HANA_POOL_RECYCLE=3600

# VCAP_SERVICES (SAP BTP). When set, overrides all HANA_* and EVENT_MESH_*
# env vars above. Expected JSON shape: the CF service-binding format.
# VCAP_SERVICES=


# ─── 6. Messaging (Kafka — INFRA_MODE=local) ────────────────────────────────────
# MESSAGING_MODE can override the broker independently of INFRA_MODE.
#   "" (default) → follows INFRA_MODE
#   "kafka"      → force Kafka
#   "event_mesh" → force SAP Event Mesh
#   "console"    → force console/stdout
MESSAGING_MODE=

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=ai-workflow
KAFKA_AUTO_OFFSET_RESET=earliest

# Topic names (rarely changed — must match worker-executor config).
KAFKA_TASK_TOPIC=workflow.tasks
KAFKA_RESULT_TOPIC=workflow.results
WORKFLOW_EVENT_TOPIC=orchestrator.workflow_event


# ─── 7. SAP Event Mesh (INFRA_MODE=sap) ─────────────────────────────────────────
# Credentials (VCAP_SERVICES takes priority if set).
EVENT_MESH_TOKEN_URL=
EVENT_MESH_MESSAGING_URL=
EVENT_MESH_MANAGEMENT_URL=
EVENT_MESH_CLIENT_ID=
EVENT_MESH_CLIENT_SECRET=
EVENT_MESH_NAMESPACE=

# Namespace hardening (SA-1468).
# REQUIRE=1: unset/empty namespace fails boot (EventMeshConfigError) instead of
# runtime 403 self-heal — recommended for prod. SELF_HEAL=0: disable the
# dev-only 403 namespace adoption entirely.
EVENT_MESH_REQUIRE_NAMESPACE=false
EVENT_MESH_ALLOW_NAMESPACE_SELF_HEAL=true

# Reliability tuning (Phase 1).
EVENT_MESH_TIMEOUT_S=30.0
EVENT_MESH_MAX_RETRIES=3
EVENT_MESH_MAX_PAYLOAD_BYTES=900000

# Async flusher (Phase 2).
EVENT_MESH_BUFFER_SIZE=10000
EVENT_MESH_BUFFER_POLICY=drop
EVENT_MESH_FLUSH_BATCH_SIZE=50
EVENT_MESH_FLUSH_CONCURRENCY=10
EVENT_MESH_MAX_CONNECTIONS=100
EVENT_MESH_MAX_KEEPALIVE_CONNECTIONS=20

# Circuit breaker + DLQ (Phase 3).
EVENT_MESH_CIRCUIT_THRESHOLD=5
EVENT_MESH_CIRCUIT_RECOVERY_S=30.0
EVENT_MESH_DLQ_ENABLED=1

# DLQ durability (SA-1471). Local spool parks durable envelopes when the DLQ
# can't take them (disabled / broker down); auto-replayed on circuit close +
# startup. Default = <tempdir>/eventmesh-dlq-spool; set empty to disable.
# Best-effort topics (comma-separated) may drop instead of spooling.
#EVENT_MESH_DLQ_SPOOL_DIR=/tmp/eventmesh-dlq-spool
EVENT_MESH_DLQ_BEST_EFFORT_TOPICS=realtime.events

# 429 isolation + REST-fallback observability (SA-1470).
# COOLDOWN_SCOPE: instance (default; SAP EM REST limit is per instance) | queue.
# REQUIRE_AMQP=1: readiness reports 503 when forced onto the REST fallback.
EVENT_MESH_429_COOLDOWN_SCOPE=instance
EVENT_MESH_REQUIRE_AMQP=false


# ─── 8. Engine / dispatcher / loop tuning ───────────────────────────────────────
# DISPATCHER_MODE — post-Phase-3a fan-out routing.
#   dispatcher (default) → DispatcherConsumer is authoritative
#   shadow               → authoritative AND records to parity recorder
#   inline / unknown     → upgraded to "dispatcher" with a warning
DISPATCHER_MODE=dispatcher

# Phase 6.3: both flags default to true. Set "false" only for emergency rollback.
EVENT_DRIVEN_LOOP=true
UNIFORM_EXECUTION=true

# Global cap on concurrent loop iterations per run (all loops combined).
MAX_CONCURRENT_ITERATIONS_PER_RUN=100

# Child-workflow timeout sweeper interval (seconds).
CHILD_TIMEOUT_SWEEP_INTERVAL_SECONDS=5


# ─── 9. Event log + projector + snapshots ───────────────────────────────────────
# EVENT_LOG_BACKEND:
#   memory (default) → ephemeral, lost on restart. OK for tests + mock.
#   sqlite           → durable on local disk. Required for real projector use.
#   hana             → durable on SAP HANA. Requires INFRA_MODE=sap. (prod)
EVENT_LOG_BACKEND=memory

# Used only when EVENT_LOG_BACKEND=sqlite.
#   ":memory:" (default) → in-process SQLite (tests)
#   /var/lib/workflow/events.db → real on-disk file for production
EVENT_LOG_DB_PATH=:memory:

# SNAPSHOT_MODE (Phase 4) — projector snapshot store.
#   off           → no snapshots (default)
#   shadow        → write snapshots, still full-replay on cold start (soak mode)
#   authoritative → cold start loads snapshot + replays tail only (prod)
SNAPSHOT_MODE=off
SNAPSHOT_EVERY_N_EVENTS=100
SNAPSHOT_EVERY_T_SECONDS=300
SNAPSHOT_KEEP_K_BACK=2


# ─── 10. Feature flags ──────────────────────────────────────────────────────────
# Node catalog v2 (/api/v2/node-catalog). Default off until Phase 3 rollout.
ENABLE_NODE_CATALOG_V2=false
# Comma-separated tenant allowlist for v2. Empty = all tenants when flag is on.
NODE_CATALOG_V2_TENANT_ALLOWLIST=

# Strict validation of FormField entries in worker contracts (Phase 3 flips true).
STRICT_CONTRACT_VALIDATION=false


# ─── 11. Clustering / multi-instance (Phase M.3) ────────────────────────────────
# Stable identifier used as the response-topic suffix so enqueue + response can
# land on different instances. Leave empty to get a random UUID per process;
# set to a deterministic value for tests or sticky-routing deployments.
INSTANCE_ID=
