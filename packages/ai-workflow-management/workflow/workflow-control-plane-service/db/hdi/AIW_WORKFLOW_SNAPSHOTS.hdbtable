COLUMN TABLE "AIW_WORKFLOW_SNAPSHOTS" (
    "ID"               NVARCHAR(64)   NOT NULL,
    "WORKFLOW_ID"      NVARCHAR(64)   NOT NULL,
    "WORKFLOW_VERSION" NVARCHAR(64)   NOT NULL,
    "DEFINITION_JSON"  NCLOB          NOT NULL,
    "CREATED_AT"       NVARCHAR(64)   NOT NULL,
    PRIMARY KEY ("ID")
)
