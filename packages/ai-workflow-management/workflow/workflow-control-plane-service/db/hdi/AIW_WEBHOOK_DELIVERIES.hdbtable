COLUMN TABLE "AIW_WEBHOOK_DELIVERIES" (
    "ID"              NVARCHAR(64)   NOT NULL,
    "REGISTRATION_ID" NVARCHAR(64),
    "RECEIVED_AT"     NVARCHAR(64),
    "OUTCOME"         NVARCHAR(32),
    "STATUS_CODE"     INTEGER,
    "EVENT_TOPIC"     NVARCHAR(512),
    "EVENT_ID"        NVARCHAR(256),
    "DETAIL"          NCLOB,
    "PAYLOAD"         NCLOB,
    PRIMARY KEY ("ID")
)
