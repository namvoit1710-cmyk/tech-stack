COLUMN TABLE "AIW_TIMERS" (
    "TIMER_ID"     NVARCHAR(64)   NOT NULL,
    "RUN_ID"       NVARCHAR(256)  NOT NULL,
    "WORKFLOW_ID"  NVARCHAR(64),
    "NODE_ID"      NVARCHAR(64),
    "KIND"         NVARCHAR(32),
    "FIRE_AT"      NVARCHAR(64),
    "CREATED_AT"   NVARCHAR(64),
    "METADATA"     NCLOB,
    PRIMARY KEY ("TIMER_ID")
)
