COLUMN TABLE "AIW_WORKFLOW_RUNS" (
    "ID"                   NVARCHAR(1024) NOT NULL,
    "WORKFLOW_ID"          NVARCHAR(64)   NOT NULL,
    "WORKFLOW_VERSION"     NVARCHAR(64)   NOT NULL,
    "INPUT_DATA"           NCLOB,
    "OUTPUT_DATA"          NCLOB,
    "STATUS"               NVARCHAR(32)   NOT NULL DEFAULT 'PENDING',
    "STARTED_AT"           NVARCHAR(64),
    "COMPLETED_AT"         NVARCHAR(64),
    "ERROR"                NCLOB,
    "CORRELATION_ID"       NVARCHAR(128),
    "CALLBACK_TOPIC"       NVARCHAR(256),
    "PARENT_RUN_ID"        NVARCHAR(1024),
    "PARENT_NODE_ID"       NVARCHAR(128),
    "DEPTH_LEVEL"          INTEGER        DEFAULT 0,
    "TENANT_ID"            NVARCHAR(256)  DEFAULT '',
    "IS_TEST"              BOOLEAN        DEFAULT FALSE,
    "TEST_MODE"            NVARCHAR(20)   DEFAULT '',
    "ROOT_RUN_ID"          NVARCHAR(1024) DEFAULT '',
    "EXECUTION_MODE"       NVARCHAR(20)   DEFAULT 'auto',
    "VERSION"              INTEGER        NOT NULL DEFAULT 0,
    "GENERATION"           INTEGER        NOT NULL DEFAULT 0,
    "USER_VARIABLES"       NCLOB,
    "WORKFLOW_SNAPSHOT_ID" NVARCHAR(64)   NOT NULL DEFAULT '',
    "METADATA"             NCLOB,
    "TRIGGERED_BY"         NVARCHAR(256),
    PRIMARY KEY ("ID")
)
