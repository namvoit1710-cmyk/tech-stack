COLUMN TABLE "AIW_WORKFLOWS" (
    "WORKFLOW_ID"     NVARCHAR(64)   NOT NULL,
    "ID"              NVARCHAR(64),
    "NAME"            NVARCHAR(256)  NOT NULL,
    "VERSION"         NVARCHAR(64),
    "DESCRIPTION"     NCLOB,
    "INPUT_SCHEMA"    NCLOB,
    "OUTPUT_SCHEMA"   NCLOB,
    "NODES"           NCLOB,
    "EDGES"           NCLOB,
    "STATUS"          NVARCHAR(32)   NOT NULL DEFAULT 'DRAFT',
    "CREATED_AT"      NVARCHAR(64)   NOT NULL,
    "METADATA"        NCLOB,
    "UPDATED_AT"      NVARCHAR(64),
    "SCHEMA_VERSION"  NVARCHAR(32)   DEFAULT '1.0.0',
    "PURPOSE"         NCLOB,
    "TEST_RUN_ID"     NVARCHAR(64),
    "ROUTING_PATH"    NCLOB,
    "MAIN_FLOW"       TINYINT        DEFAULT 0,
    "ACTION"          NCLOB,
    "INSTRUCTION"     NCLOB,
    "AGENTS_JSON"     NCLOB,
    "VARIABLES"       NCLOB,
    "CREATED_BY"      NVARCHAR(256),
    "UPDATED_BY"      NVARCHAR(256),
    "OWNER"           NVARCHAR(256),
    "REVISION"        BIGINT,
    PRIMARY KEY ("WORKFLOW_ID")
)
