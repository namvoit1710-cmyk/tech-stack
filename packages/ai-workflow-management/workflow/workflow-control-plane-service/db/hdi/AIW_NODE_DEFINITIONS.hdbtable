COLUMN TABLE "AIW_NODE_DEFINITIONS" (
    "ID"                    NVARCHAR(64)   NOT NULL,
    "TENANT_ID"             NVARCHAR(64)   NOT NULL,
    "NAME"                  NVARCHAR(256)  NOT NULL,
    "DESCRIPTION"           NCLOB,
    "PARENT_DEFINITION_ID"  NVARCHAR(64),
    "BASE_TYPE"             NVARCHAR(32)   NOT NULL,
    "BASE_WORKER_ID"        NVARCHAR(128),
    "LOCKED_DEFAULTS"       NCLOB,
    "INPUT_SCHEMA"          NCLOB,
    "OUTPUT_SCHEMA"         NCLOB,
    "INPUT_MAPPING"         NCLOB,
    "OUTPUT_MAPPING"        NCLOB,
    "ICON"                  NVARCHAR(64),
    "COLOR"                 NVARCHAR(32),
    "TAGS"                  NCLOB,
    "PORTS"                 NCLOB,
    "DATA_MODE"             NVARCHAR(32)   DEFAULT 'json',
    "EDIT_MODE"             NVARCHAR(32)   DEFAULT 'none',
    "KIND"                  NVARCHAR(32),
    "COLLECTION"            NVARCHAR(256),
    "CREATED_AT"            NVARCHAR(64)   NOT NULL,
    "UPDATED_AT"            NVARCHAR(64),
    PRIMARY KEY ("ID")
)
