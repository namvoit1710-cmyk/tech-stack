COLUMN TABLE "AIW_TASKS" (
    "ID"              NVARCHAR(1024) NOT NULL,
    "RUN_ID"          NVARCHAR(1024) NOT NULL,
    "NODE_ID"         NVARCHAR(128)  NOT NULL,
    "STATUS"          NVARCHAR(32)   NOT NULL DEFAULT 'PENDING',
    "INPUT_REFS"      NCLOB,
    "OUTPUT_REF"      NCLOB,
    "RETRY_COUNT"     INTEGER        NOT NULL DEFAULT 0,
    "STARTED_AT"      NVARCHAR(64),
    "COMPLETED_AT"    NVARCHAR(64),
    "ERROR"           NCLOB,
    "WORKER_ID"       NVARCHAR(128),
    "OUTPUT_METADATA" NCLOB,
    "LOOP_CONTEXT"    NCLOB,
    "ITERATION_INDEX" INTEGER,
    "IDEMPOTENCY_KEY" NVARCHAR(1280),
    "CREATED_AT"      NVARCHAR(64),
    "RUN_GENERATION"  INTEGER        NOT NULL DEFAULT 0,
    "SCOPE_STACK"     NCLOB,
    PRIMARY KEY ("ID")
)
