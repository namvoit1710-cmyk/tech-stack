COLUMN TABLE "AIW_RUN_SNAPSHOTS" (
    "RUN_ID"         NVARCHAR(256)  NOT NULL,
    "SEQUENCE"       INTEGER        NOT NULL,
    "SCHEMA_VERSION" INTEGER        NOT NULL,
    "STATE_JSON"     NCLOB          NOT NULL,
    "CREATED_AT"     NVARCHAR(64)   NOT NULL,
    PRIMARY KEY ("RUN_ID", "SEQUENCE")
)
