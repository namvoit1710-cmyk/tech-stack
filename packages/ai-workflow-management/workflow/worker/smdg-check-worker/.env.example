# SMDG Check Worker — environment template. Copy to `.env` and fill in.
# `.env` is git-ignored; this `.env.example` is the tracked reference.
#
# This worker holds NO credentials: each node resolves its OAuth credential from the
# flow's environment/Section (node `credential_ref` bound to {{$env.OAUTH}}), and the
# endpoint base URLs come from {{$env.*_BASE_API_URL}}. So `.env` is run config only.

# --- Run mode ---------------------------------------------------------------
APP_MODE=PULL
REGISTRY_URL=https://smdg-ai-tenant-1-ai-workflow-worker-executor.cfapps.br10.hana.ondemand.com
WORKER_TENANT=
# Total in-flight tasks across all node types (blank = uncapped per node type).
WORKER_MAX_CONCURRENT=1
