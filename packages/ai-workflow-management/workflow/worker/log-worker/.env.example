# SMDG Log Worker — environment template. Copy to `.env` and fill in.
# `.env` is git-ignored; this `.env.example` is the tracked reference.
#
# NOTE (see app/config.py): the shared worker-sdk builds its Settings singleton with
# extra="forbid", so EVERY key here must be declared on app/config.Settings or the
# process aborts at import. Keep this file to declared keys only.

# --- Run mode ---------------------------------------------------------------
APP_MODE=PULL
# REGISTRY_URL=https://<worker-executor-host>
# WORKER_TENANT=

# --- OAuth client credentials: LOG_WORKER_CLIENT_ID_<CUSTOMER>_<ENV> --------
# The get-log nodes pick the set from the target link (or an explicit `cred_env`
# node field: mck_dev | mck_qas | alcon_qas | s4_qas).

# MCK (McKesson) — dev (was the old un-suffixed LOG_WORKER_CLIENT_ID / _SECRET)
LOG_WORKER_CLIENT_ID_MCK_DEV=
LOG_WORKER_CLIENT_SECRET_MCK_DEV=
# MCK — qas (was LOG_WORKER_CLIENT_ID_QAS / _SECRET_QAS)
LOG_WORKER_CLIENT_ID_MCK_QAS=
LOG_WORKER_CLIENT_SECRET_MCK_QAS=

# ALCON / Alcon (SA-2438) — host token is "alcon" (alcon-dev/qas-simplemdg…)
LOG_WORKER_CLIENT_ID_ALCON_DEV=
LOG_WORKER_CLIENT_SECRET_ALCON_DEV=
LOG_WORKER_CLIENT_ID_ALCON_QAS=
LOG_WORKER_CLIENT_SECRET_ALCON_QAS=

# S4 — qas
LOG_WORKER_CLIENT_ID_S4_QAS=
LOG_WORKER_CLIENT_SECRET_S4_QAS=

# --- Cloud Logging (OpenSearch) nodes ---------------------------------------
CLS_URL=
CLS_USERNAME=
CLS_PASSWORD=
