# req2tpl worker — local PULL configuration.
# Copy to `.env` (git-ignored). No secret belongs in this file: the Jira
# credential is resolved from the vault at run time via the node's
# credential_ref, never from disk or environment.

# --- delivery -----------------------------------------------------------------
APP_MODE=PULL
REGISTRY_URL=https://smdg-ai-tenant-1-ai-workflow-worker-executor.cfapps.br10.hana.ondemand.com
WORKER_TENANT=

# How many tasks this process runs at once. req2tpl is CPU-light and short, but
# each build writes into its own run directory, so keep concurrent runs on
# DIFFERENT run_dir values. 0/unset = one at a time.
WORKER_MAX_CONCURRENT=2
LEASE_MAX_BATCH=2

# --- req2tpl CLI --------------------------------------------------------------
# Absolute path to the built binary (cargo build --release). Blank = PATH lookup.
REQ2TPL_BIN=C:/Users/EdgarNguyen/workspace/project/smdg/requirement-to-template/req2tpl/target/release/req2tpl.exe

# Every path a workflow names is confined below this root. Blank =
# ~/.req2tpl-worker/runs
REQ2TPL_WORKSPACE=

REQ2TPL_TIMEOUT_SECONDS=300
REQ2TPL_MAX_ATTACHMENT_BYTES=67108864
