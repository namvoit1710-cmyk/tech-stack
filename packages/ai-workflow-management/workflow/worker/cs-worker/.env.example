# cs-worker credentials. Copy to .env — GITIGNORED, and excluded from the image by the
# shared ../.dockerignore. Never commit a real value.
#
# ADDING A PROJECT + ENVIRONMENT = the four LOG_WORKER_* lines below (plus three more
# if that landscape has its own Cloud Logging), then:
#     docker compose up -d
# The boot log prints what it resolved:  [cs-worker] targets: MCK (DEV, QAS); ALCON (DEV)

APP_MODE=PULL
WORKER_TENANT=
REGISTRY_URL=https://smdg-ai-tenant-1-ai-workflow-worker-executor.cfapps.br10.hana.ondemand.com

# --- Claude CLI (cs_detect_request + cs_summarize_log) -----------------------
# Comma-separated for rotation on a usage/rate limit. Keep the count >= WORKER_MAX_CONCURRENT.
CLAUDE_WORKER_CLAUDE_CLI_TOKEN=

# --- BTP Cloud Logging -------------------------------------------------------
# Per project + environment, like everything else below. All three or none: a partial
# set authenticates as nobody, and the 401 is harder to read than a missing variable.
# Optional — a landscape without Cloud Logging still serves process logs.
# LOG_WORKER_CLS_URL_<PROJECT>_<ENV>       the dashboards-endpoint from the service key
# LOG_WORKER_CLS_USERNAME_<PROJECT>_<ENV>  the OpenSearch INTERNAL user, not the service
# LOG_WORKER_CLS_PASSWORD_<PROJECT>_<ENV>  key's dashboards user

# Shared fallback, used when the node names no project or that project has none of its
# own. Enough on its own if the whole landscape really does share one instance.
CLS_URL=
CLS_USERNAME=
CLS_PASSWORD=

# --- Projects × environments -------------------------------------------------
# LOG_WORKER_CLIENT_ID_<PROJECT>_<ENV>      OAuth client for CommonProcessService
# LOG_WORKER_CLIENT_SECRET_<PROJECT>_<ENV>
# LOG_WORKER_APP_PREFIX_<PROJECT>_<ENV>     the CF app-name prefix of that landscape
# LOG_WORKER_REGION_<PROJECT>_<ENV>         the CF region of its apps (br10, us20, …)
# LOG_WORKER_CLS_URL_<PROJECT>_<ENV>        that landscape's Cloud Logging (optional)
# LOG_WORKER_CLS_USERNAME_<PROJECT>_<ENV>
# LOG_WORKER_CLS_PASSWORD_<PROJECT>_<ENV>
#
# The last underscore separates PROJECT from ENVIRONMENT: S4_QAS reads as project S4,
# environment QAS. From the prefix + region the worker derives:
#     token : https://<prefix>.authentication.<auth_region>.hana.ondemand.com/oauth/token
#     api   : https://<prefix>-srv-process-system.cfapps.<region>.hana.ondemand.com/CommonProcessService
#     abap  : https://<prefix>-srv-config-admin.cfapps.<region>.hana.ondemand.com/AdminService/<entity>
#     web   : https://<prefix>-web.cfapps.<web_region>.hana.ondemand.com   (the CR deep link)
#
# --- when one region is not enough -------------------------------------------
# LOG_WORKER_AUTH_REGION_<PROJECT>_<ENV>    region of the UAA, if it differs from REGION
# LOG_WORKER_WEB_REGION_<PROJECT>_<ENV>     region of the web app, if it differs
#
# Both default to REGION, so the usual landscape still needs only the four lines above.
# Set them for a landscape that is split — ALCON QAS runs its apps in us10-003 and its
# UAA in us10 (measured 25/08/2026, after the whole target had been configured for br10
# and had therefore never worked: br10 answers "Requested route does not exist" for
# every one of its apps).
#
# --- when a landscape lacks something ----------------------------------------
# LOG_WORKER_ABAP_ENTITY_<PROJECT>_<ENV>    the AdminService entity, or `none`
# LOG_WORKER_WEB_URL_<PROJECT>_<ENV>        full web base, or `none` for no CR link
#
# `none` is not a workaround, it is the answer: the node then says the log is
# unavailable in one sentence instead of returning a raw 404, and the reply carries no
# link rather than a dead one. Measured per landscape by asking each AdminService for
# its own entity list — do that rather than assuming.

LOG_WORKER_CLIENT_ID_MCK_DEV=
LOG_WORKER_CLIENT_SECRET_MCK_DEV=
LOG_WORKER_APP_PREFIX_MCK_DEV=mckesson-dev-simplemdg
LOG_WORKER_REGION_MCK_DEV=us20
LOG_WORKER_ABAP_ENTITY_MCK_DEV=MDApiLog
LOG_WORKER_CLS_URL_MCK_DEV=
LOG_WORKER_CLS_USERNAME_MCK_DEV=
LOG_WORKER_CLS_PASSWORD_MCK_DEV=

LOG_WORKER_CLIENT_ID_MCK_QAS=
LOG_WORKER_CLIENT_SECRET_MCK_QAS=
LOG_WORKER_APP_PREFIX_MCK_QAS=mckesson-qas-simplemdg
LOG_WORKER_REGION_MCK_QAS=us20
# This AdminService serves CompanySetting/GlobalSettings/… and no MD API log.
LOG_WORKER_ABAP_ENTITY_MCK_QAS=none
LOG_WORKER_CLS_URL_MCK_QAS=
LOG_WORKER_CLS_USERNAME_MCK_QAS=
LOG_WORKER_CLS_PASSWORD_MCK_QAS=

LOG_WORKER_CLIENT_ID_ALCON_DEV=
LOG_WORKER_CLIENT_SECRET_ALCON_DEV=
LOG_WORKER_APP_PREFIX_ALCON_DEV=alcon-dev-simplemdg
LOG_WORKER_REGION_ALCON_DEV=br10
# A different AdminService entirely (Questionnaires/Questions/…) — no MD API log.
LOG_WORKER_ABAP_ENTITY_ALCON_DEV=none
LOG_WORKER_CLS_URL_ALCON_DEV=
LOG_WORKER_CLS_USERNAME_ALCON_DEV=
LOG_WORKER_CLS_PASSWORD_ALCON_DEV=

LOG_WORKER_CLIENT_ID_ALCON_QAS=
LOG_WORKER_CLIENT_SECRET_ALCON_QAS=
LOG_WORKER_APP_PREFIX_ALCON_QAS=alcon-qas-simplemdg
# Split landscape: apps (and the web app) in us10-003, UAA in us10. NOT br10 — that was
# the original configuration and no app of this landscape has ever existed there.
LOG_WORKER_REGION_ALCON_QAS=us10-003
LOG_WORKER_AUTH_REGION_ALCON_QAS=us10
# Set to `none` while unverified: srv-config-admin does answer in us10-003, so this
# landscape may well have an ABAP log — re-check once its credentials work.
LOG_WORKER_ABAP_ENTITY_ALCON_QAS=none
LOG_WORKER_CLS_URL_ALCON_QAS=
LOG_WORKER_CLS_USERNAME_ALCON_QAS=
LOG_WORKER_CLS_PASSWORD_ALCON_QAS=

LOG_WORKER_CLIENT_ID_S4_QAS=
LOG_WORKER_CLIENT_SECRET_S4_QAS=
LOG_WORKER_APP_PREFIX_S4_QAS=smdg-s4-qas-simplemdg
LOG_WORKER_REGION_S4_QAS=br10
# MDApiLog, with real rows. NOT CeAppLogMsg — the published S4 log flow points at that
# entity and it answers 502.
LOG_WORKER_ABAP_ENTITY_S4_QAS=MDApiLog
LOG_WORKER_CLS_URL_S4_QAS=
LOG_WORKER_CLS_USERNAME_S4_QAS=
LOG_WORKER_CLS_PASSWORD_S4_QAS=

# --- Optional per-target overrides, for a landscape the formula does not fit ---
# LOG_WORKER_API_URL_<PROJECT>_<ENV>=https://…/CommonProcessService
# LOG_WORKER_TOKEN_URL_<PROJECT>_<ENV>=https://…/oauth/token
# LOG_WORKER_ABAP_URL_<PROJECT>_<ENV>=https://…/AdminService/MDApiLog

# --- Optional: what a human might call a project ------------------------------
# So "the McKesson DEV logs" resolves without depending on the model.
LOG_WORKER_PROJECT_ALIASES_MCK=MCKESSON,MCKES
LOG_WORKER_PROJECT_ALIASES_S4=S4HANA,SMDG_S4
