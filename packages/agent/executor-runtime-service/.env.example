# Executor Runtime Service
APP_NAME=Executor Runtime Service
APP_MODE=CONSUMER
AGENT_TYPE=executor-runtime
AGENT_DOMAIN=execution

# Messaging
MESSAGING_MODE=mock
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=executor-runtime-group
KAFKA_REQUEST_TOPIC=agent.request.executor
EVENT_MESH_REQUEST_TOPIC=agent.request.executor
EVENT_MESH_REPLY_TOPIC=executor.step.status
EVENT_MESH_NAMESPACE=default
EVENT_MESH_TOKEN_URL=
EVENT_MESH_CLIENT_ID=
EVENT_MESH_CLIENT_SECRET=
EVENT_MESH_MESSAGING_URL=
EVENT_MESH_MANAGEMENT_URL=
EVENT_MESH_BROKER_URL=

# Queue topics
QUEUE_REQUEST_TOPIC=agent.request.executor
QUEUE_REPLY_TOPIC=executor.step.status
STATUS_PUBLISH_TOPIC=executor.step.status

# Registry
REGISTRY_URL=http://localhost:8080

# LLM (not used directly by executor, only by tools that need it)
LLM_MODEL=
OPENAI_API_KEY=

# HANA — durable persistence.
# Setting HANA_HOST switches the executor onto the agent-sdk's TRANSACTIONAL OUTBOX:
# the SDK builds HanaOutboxRepository, wraps container["publisher"] with OutboxPublisher
# (persist-then-publish), and run_consumer_agent runs the flush-loop relay + startup
# crash-replay. Leave HANA_HOST blank to keep the legacy fire-and-forget publisher.
# Local dev target = the WSL HANA (SYSTEM). NEVER commit a real password here.
HANA_HOST=
HANA_PORT=39041
HANA_USERNAME=SYSTEM
HANA_PASSWORD=
# How often the SDK relay re-publishes PENDING/FAILED outbox rows (seconds).
OUTBOX_FLUSH_INTERVAL_SECONDS=30

# WORKFLOW_CONTROL_PLANE
WORKFLOW_CONTROL_PLANE_URL=
WORKFLOW_CONTROL_PLANE_TIMEOUT_SECONDS=
