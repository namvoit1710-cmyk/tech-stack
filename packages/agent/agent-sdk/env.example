APP_NAME=Agent SDK
APP_MODE=SERVER
AGENT_TYPE=generic
AGENT_VERSION=0.1.0
AGENT_DOMAIN=general
SERVER_PORT=36000
ALLOW_ORIGINS=["*"]
REGISTRY_URL=http://localhost:8003

# Messaging / transport mode: mock (console/no-op), local (Kafka), sap (SAP Event Mesh)
INFRA_MODE=mock
# Leave MESSAGING_MODE blank to fall back to INFRA_MODE; set explicitly to override.
MESSAGING_MODE=

# Push-gateway fan-out transport: defaults to gRPC.
# Set to http to opt into HTTP delivery.
PUSH_GATEWAY_TRANSPORT=grpc
# HTTP push-gateway base URL used when PUSH_GATEWAY_TRANSPORT=http.
# Leave blank to disable push-gateway fan-out without affecting broker delivery.
PUSH_GATEWAY_URL=
# gRPC target used when PUSH_GATEWAY_TRANSPORT=grpc (for example host:port).
# Current SDK scope is unary SendData calls only.
PUSH_GATEWAY_GRPC_TARGET=

# Kafka settings (required when the resolved messaging mode is local)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REQUEST_TOPIC=agent.request
KAFKA_RESPONSE_TOPIC=agent.responses
KAFKA_GROUP_ID=agent-sdk-consumer

# SAP Event Mesh settings (required when MESSAGING_MODE=sap)
# EVENT_MESH_MESSAGING_URL is the publish/consume REST base URL.
# EVENT_MESH_MANAGEMENT_URL is the queue/topic provisioning REST base URL.
# EVENT_MESH_BROKER_URL remains the compatibility fallback for either URL.
EVENT_MESH_NAMESPACE=default
EVENT_MESH_TOKEN_URL=
EVENT_MESH_CLIENT_ID=
EVENT_MESH_CLIENT_SECRET=
EVENT_MESH_MESSAGING_URL=http://localhost:18080
EVENT_MESH_BROKER_URL=
EVENT_MESH_MANAGEMENT_URL=http://localhost:18080
EVENT_MESH_REQUEST_TOPIC=agent.request

# Provider credential env vars are integration-specific.
# Example for OpenAI: OPENAI_API_KEY=...
OPENAI_API_KEY=

# Generic provider-agnostic LLM settings
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=
LLM_TEMPERATURE=0.01
LLM_TIMEOUT=
LLM_MAX_TOKENS=
LLM_MAX_RETRIES=6
# JSON object of extra provider-specific chat-model kwargs passed through unchanged.
# Example: {"reasoning_effort": "medium"}
# Responses API / Azure-style example: {"reasoning": {"effort": "medium"}}
LLM_MODEL_KWARGS={}

# SAP HANA connection settings (from VCAP_SERVICES or environment variables)
HANA_HOST=
HANA_PORT=443
HANA_USERNAME=
HANA_PASSWORD=
HANA_SCHEMA=
HANA_ENCRYPT=true
HANA_SSL_CERT=
HANA_POOL_SIZE=5
HANA_MAX_OVERFLOW=10
HANA_POOL_RECYCLE=3600

# Set to true to load HANA credentials from Cloud Foundry VCAP_SERVICES
GET_FROM_VCAP=false

# MCP Client Configuration (optional)
# Legacy-compatible exact endpoint form (the `url` value is used as-is)
# MCP_SERVERS=[{"name": "tools-server", "url": "http://localhost:8080/mcp"}]
# Recommended shared-client-native form for new configs
# MCP_SERVERS=[{"name": "tools-server", "server_url": "http://localhost:8080", "transport": "streamable-http", "streamable_http_path": "/mcp/http/mcp"}]
# Example SSE form
# MCP_SERVERS=[{"name": "tools-server", "server_url": "http://localhost:8080", "transport": "sse", "sse_path": "/mcp/sse/sse"}]
MCP_SERVERS=[]
# Filter MCP tools by name (empty = all tools available)
# MCP_TOOL_FILTER=["add", "multiply"]
MCP_TOOL_FILTER=[]

