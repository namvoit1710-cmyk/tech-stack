APP_NAME=CSV File Agent
APP_MODE=SERVER
AGENT_TYPE=csv-file
AGENT_VERSION=1.0.0
AGENT_DOMAIN=templates
DESCRIPTION=CSV File Transformation, template editing, and node file import engine. This agent edits CSV file content, performs row and column operations, fills template values, toggles UI properties, maps data between tables and fields, and imports uploaded CSV files into workflow node Template Input Setting fields. It outputs either the latest modified file state or a workflow node input update result. Example prompts: "Fill description data for me", "Map table ADR6 to field ADDRNUMBER", "add new row", "delete column", "Import this uploaded CSV file into the Template Input Setting fields", "Attach this CSV file to node input".
SERVER_PORT=37001
REGISTRY_URL=http://localhost:8003
AGENT_ADVERTISED_HOST=localhost

CAPABILITIES=["csv_content_editing","row_column_manipulation","data_value_injection","field_mapping_logic","attribute_toggling","template_input_csv_import","workflow_node_input_update"]

INPUT_SCHEMA={"type":"object","properties":{"message":{"type":"string","description":"User instruction describing the modification"},"file_id":{"type":"string","description":"ID of the file to modify"}},"required":["message","file_id"]}
OUTPUT_SCHEMA={"type":"object","properties":{"modified_file_url":{"type":"string"},"changes_summary":{"type":"string"}}}
REQUIRED_PARAMETERS=["message", "file_id"]
NEGATIVE_EXAMPLES=["extract data only","detect headers","what is this workflow","explain this concept","answer my question"]
REQUIRED_CONFIRMATION=true
ROUTING_TIMEOUT_SECONDS=180.0

# SDK LLM Configuration
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.01
LLM_TIMEOUT=60.0

# Upstream Services
FILE_URL=https://smdg-ai-dev-file-service.cfapps.br10.hana.ondemand.com
WORKFLOW_API_BASE_URL=https://smdg-ai-dev-ai-workflow-control-plane.cfapps.br10.hana.ondemand.com

# MCP Integration
DATA_FACTORY_URL=https://smdg-ai-dev-data-factory.cfapps.br10.hana.ondemand.com
DATA_FACTORY_MCP_TRANSPORT=streamable-http
DATA_FACTORY_EXPOSE_RAW_MCP_TOOLS=false

# Persistence (Optional)
HANA_HOST=localhost
HANA_PORT=39041
HANA_USERNAME=SYSTEM
HANA_PASSWORD=<your-password>
HANA_SCHEMA=SYSTEM
HANA_ENCRYPT=false
HANA_SSL_CERT=
HANA_POOL_SIZE=5
HANA_MAX_OVERFLOW=10
HANA_POOL_RECYCLE=3600
