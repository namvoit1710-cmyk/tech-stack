# Server
SERVER_PORT=36010

# Agent identity
AGENT_TYPE=troubleshooting-agent
AGENT_DOMAIN=workflow-ops
DESCRIPTION=Diagnoses Workflow Service run failures from the control-plane execution log (SA-1438).
DEFAULT_QUEUE_NAME=workflow.troubleshoot.queue
DEFAULT_QUEUE_TYPE=event

# Registry (leave empty to run offline; set to enable registry sync at startup)
REGISTRY_URL=
REGISTRY_API_URL=

# Workflow Control Plane root URL. Empty -> the client returns a mock execution log.
# e.g. https://smdg-ai-tenant-1-ai-workflow-control-plane.cfapps.br10.hana.ondemand.com
WORKFLOW_API_URL=

# Transport
APP_MODE=SERVER
MESSAGING_MODE=mock
INFRA_MODE=mock

# HANA (optional; not required for diagnose-only)
HANA_HOST=

# LLM (optional; the diagnosis is deterministic without it — LLM only enriches narrative)
OPENAI_API_KEY=
LLM_MODEL=
