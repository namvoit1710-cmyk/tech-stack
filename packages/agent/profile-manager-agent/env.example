APP_NAME=Profile Manager Agent
APP_MODE=SERVER
AGENT_TYPE=profile-manager
AGENT_VERSION=1.0.0
AGENT_DOMAIN=odata
DESCRIPTION=This agent is used when the user wants to check or filter data using OData((including in Profile Manager)) (e.g., 'name is Thomas', 'status equals active'). It converts these conditions into OData query parameters to retrieve matching records. Do not use this for validation or validation column checks. Example Prompts: "check name is Thomas in Odata", "check role is Admin in Odata", "in Odata, email should not empty"
SERVER_PORT=37002
REGISTRY_URL=http://localhost:8003
OPENAI_API_KEY=
CAPABILITIES=["nl_to_odata","condition_parsing","filter_generation","sorting_generation","pagination_generation","field_selection","schema_validation","query_validation"]
INPUT_SCHEMA={"type":"object","properties":{"message":{"type":"string"}},"required":["message"]}
OUTPUT_SCHEMA={"type":"object","properties":{"message":{"type":"string"},"odata_query":{"type":"string"}},"valid":{"type":"string"}}
NEGATIVE_EXAMPLES=["fix invalid emails","delete users with no email","update user name to John","show users with good data","email is wrong","make emails valid","users better than others"]
PROFILE_MANAGEMENT_BASE_URL=https://smdg-ai-dev-profile-qas.cfapps.br10.hana.ondemand.com
