# ── Common Service Settings ──
LOG_LEVEL=INFO
APP_MODE=REST
MESSAGING_MODE=

# Infrastructure mode: mock | local | sap
INFRA_MODE=mock

# ── SAP HANA ──
HANA_HOST=
HANA_PORT=443
HANA_USERNAME=
HANA_PASSWORD=
HANA_SCHEMA=
HANA_ENCRYPT=true
HANA_SSL_CERT=
HANA_POOL_SIZE=5
HANA_MAX_OVERFLOW=10
HANA_POOL_RECYCLE=3600

# ── Messaging ──
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=ai-workflow
KAFKA_AUTO_OFFSET_RESET=earliest

# ── SAP Event Mesh ──
EVENT_MESH_TOKEN_URL=
EVENT_MESH_MESSAGING_URL=
EVENT_MESH_MANAGEMENT_URL=
EVENT_MESH_CLIENT_ID=
EVENT_MESH_CLIENT_SECRET=
EVENT_MESH_NAMESPACE=

# ── Orchestrator Service ──
SERVER_PORT=8005
INSTANCE_ID=orchestrator-001
AGENT_REGISTRY_URL=http://localhost:8003
WORKFLOW_API_BASE_URL=http://localhost:8005
PROFILE_API_BASE_URL=

# ── LLM Provider ──
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
