APP_NAME=Workflow Designer Agent
APP_MODE=SERVER
AGENT_TYPE=workflow-designer
AGENT_VERSION=1.0.0
AGENT_DOMAIN=workflow
DESCRIPTION=Conversational workflow designer. Given a natural-language goal, it designs a complete multi-node workflow (nodes + edges + per-node config) in one pass, and asks a single focused clarifying question when a required detail is missing. Example prompts: "Build a workflow that ingests a CSV, validates it, then emails a report", "Create a workflow that syncs new records every hour and notifies me on failure".
SERVER_PORT=37010
REGISTRY_URL=http://localhost:8003
AGENT_ADVERTISED_HOST=localhost
ROUTING_TIMEOUT_SECONDS=120.0

CAPABILITIES=["workflow_generation","workflow_design","node_configuration","workflow_validation","clarification_dialog"]

INPUT_SCHEMA={"type":"object","properties":{"message":{"type":"string","description":"Natural-language description of the workflow to build"}},"required":["message"]}
OUTPUT_SCHEMA={"type":"object","properties":{"workflow":{"type":"object","description":"Generated workflow definition (name, description, nodes, edges)"},"status":{"type":"string"}}}
REQUIRED_PARAMETERS=["message"]
NEGATIVE_EXAMPLES=["run this workflow now","delete a workflow","explain this concept","modify a file","edit a CSV"]
REQUIRED_CONFIRMATION=true

# LLM — model "5.4 nano" (generic provider-agnostic config; the SDK reads LLM_MODEL/LLM_PROVIDER)
LLM_MODEL=gpt-5.4-nano
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

WORKFLOW_API_BASE_URL=https://smdg-ai-dev-ai-workflow-control-plane.cfapps.br10.hana.ondemand.com
# Frontend base used to build clickable "view workflow" links in agent responses
WORKFLOW_APP_URL=https://smdg-ai-dev-workflow-management.cfapps.br10.hana.ondemand.com
# Troubleshooting-agent (SA-1438) the diagnose_failure tool calls over HTTP (POST
# /api/v1/execute). Empty disables diagnosis; local default is its SERVER_PORT (36010).
TROUBLESHOOTING_AGENT_URL=http://localhost:36010
