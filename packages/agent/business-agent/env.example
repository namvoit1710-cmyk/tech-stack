# Server Configuration
SERVER_PORT=36001

# === Agent Identity ===
AGENT_TYPE=business-agent
AGENT_DOMAIN=blueprints
DESCRIPTION=Reusable Python agent blueprint with clean layers and SDK integration.
DEFAULT_QUEUE_NAME=workflow.default.queue
DEFAULT_QUEUE_TYPE=event
REGISTRY_API_URL=
WORKFLOW_API_URL=

# === Routing Metadata (for dynamic discovery by supervisor agents) ===
# These fields are sent to the registry at startup and read by AgentDiscoveryService.
# See docs/remote-agents.md for the full multi-agent flow.
REQUIRED_PARAMETERS=[]
NEGATIVE_EXAMPLES=["service contract is undefined", "required business feature is missing"]
INPUT_SCHEMA={}
OUTPUT_SCHEMA={}
ROUTING_TIMEOUT_SECONDS=30.0

# === Transport / Messaging ===
# APP_MODE: SERVER (default) or CONSUMER (Kafka/SAP consumer loop)
APP_MODE=SERVER
# MESSAGING_MODE takes precedence over INFRA_MODE when set.
# Values: "" (unset → use INFRA_MODE), "mock" (no-op/console), "local" (Kafka), "sap" (SAP Event Mesh)
MESSAGING_MODE=mock
# INFRA_MODE: fallback transport selector used only when MESSAGING_MODE is unset.
INFRA_MODE=mock
# Process one broker delivery at a time so workflow events stay ordered.
CONSUMER_MAX_IN_FLIGHT_MESSAGES=1
# PUSH_GATEWAY_TRANSPORT defaults to grpc.
# Set to http to opt into HTTP delivery.
PUSH_GATEWAY_TRANSPORT=grpc
# PUSH_GATEWAY_URL: optional HTTP fan-out endpoint used when transport=http.
# When set, terminal workflow events (WORKFLOW_COMPLETED/WORKFLOW_FAILED) are
# also delivered via HTTP POST alongside broker publishing.
PUSH_GATEWAY_URL=
# PUSH_GATEWAY_GRPC_TARGET: optional host:port target used when transport=grpc.
# Current SDK scope is unary SendData calls only.
PUSH_GATEWAY_GRPC_TARGET=

# HANA Configuration (Optional for the Business Agent)
HANA_HOST=
HANA_PORT=30015
HANA_USERNAME=
HANA_PASSWORD=
HANA_SCHEMA=
HANA_ENCRYPT=true

# OpenAI Configuration
OPENAI_API_KEY=
LLM_MODEL=

RAG_API_URL: str = ""
RAG_TOP_K: int = 10

