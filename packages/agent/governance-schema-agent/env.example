APP_NAME=Governance Schema Agent
APP_MODE=SERVER
AGENT_TYPE=governance-schema
AGENT_VERSION=1.0.0
AGENT_DOMAIN=templates
DESCRIPTION=Governance Schema Agent. This agent generates record step schemas based on provided input, ensuring strict adherence to rules and constraints. It outputs structured record steps as JSON. Example Prompts: "1. Send to sara.le@company.com to contribute Procurement data (purchasing group, order unit)", "2. Send to daniel.vo@company.com to contribute Supply Chain data (MRP type, lot size)".
SERVER_PORT=37006
REGISTRY_URL=https://smdg-ai-dev-ai-workflow-executor.cfapps.br10.hana.ondemand.com
AGENT_ADVERTISED_HOST=localhost

CAPABILITIES=["create_step_record"]

INPUT_SCHEMA={"type":"object","properties":{"message":{"type":"string","description":"User instruction describing the modification"}},"required":["message"]}
OUTPUT_SCHEMA={"type":"object","properties":{"message":{"type":"string"}}}
REQUIRED_PARAMETERS=["message"]
NEGATIVE_EXAMPLES=["extract data only","detect headers","what is this workflow","explain this concept","answer my question"]
REQUIRED_CONFIRMATION=false
ROUTING_TIMEOUT_SECONDS=180.0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.01

FILE_URL=https://smdg-ai-dev-file-service.cfapps.br10.hana.ondemand.com
DATA_FACTORY_URL=https://smdg-ai-dev-data-factory.cfapps.br10.hana.ondemand.com
