APP_NAME=Modify File Agent
APP_MODE=SERVER
AGENT_TYPE=modify-file
AGENT_VERSION=1.0.0
AGENT_DOMAIN=templates
DESCRIPTION=File Transformation, template editing, and node file import engine. This agent edits file content, performs row and column operations, fills template values, toggles UI properties, maps data between tables and fields, and imports uploaded files into workflow node Template Input Setting fields. It outputs either the latest modified file state or a workflow node input update result. Example prompts: "Fill description data for me", "Map table ADR6 to field ADDRNUMBER", "add new row", "delete column", "Import this uploaded file into the Template Input Setting fields", "Attach this file to node input".
SERVER_PORT=37000
REGISTRY_URL=http://localhost:8003
AGENT_ADVERTISED_HOST=localhost

CAPABILITIES=["file_content_editing","row_column_manipulation","data_value_injection","field_mapping_logic","attribute_toggling","template_input_file_import","workflow_node_input_update"]

INPUT_SCHEMA={"type":"object","properties":{"message":{"type":"string","description":"User instruction describing the modification"},"file_id":{"type":"string","description":"ID of the file to modify"}},"required":["message","file_id"]}
OUTPUT_SCHEMA={"type":"object","properties":{"modified_file_url":{"type":"string"},"changes_summary":{"type":"string"}}}
REQUIRED_PARAMETERS=["message", "file_id"]
NEGATIVE_EXAMPLES=["extract data only","detect headers","what is this workflow","explain this concept","answer my question"]
REQUIRED_CONFIRMATION=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.01

FILE_URL=https://smdg-ai-dev-file-service.cfapps.br10.hana.ondemand.com
DATA_FACTORY_URL=https://smdg-ai-dev-data-factory.cfapps.br10.hana.ondemand.com
WORKFLOW_API_BASE_URL=https://smdg-ai-dev-ai-workflow-control-plane.cfapps.br10.hana.ondemand.com

