APP_NAME=Validate Rule Agent
APP_MODE=SERVER
AGENT_TYPE=validation-rule
AGENT_VERSION=1.0.0
AGENT_DOMAIN=templates
DESCRIPTION=Validate data for column of file.This agent performs active validation on column. It outputs the final modified file state or URL. Example Prompts: "First column is not empty", "I want the check column name is unique", "Check coulmn email with format abc@gmail.com".
SERVER_PORT=37001
REGISTRY_URL=http://localhost:8003
CAPABILITIES=["validate_column_unique", "validatie_by_polar", "validate_not_empty"]
FILE_URL=https://smdg-ai-dev-file-service.cfapps.br10.hana.ondemand.com
DATA_FACTORY_URL=https://smdg-ai-dev-data-factory.cfapps.br10.hana.ondemand.com
OPENAI_API_KEY=
HANA_HOST=localhost
HANA_PORT=39041
HANA_USERNAME=SYSTEM
HANA_PASSWORD=
HANA_SCHEMA=SYSTEM
HANA_ENCRYPT=false
HANA_SSL_CERT=
HANA_POOL_SIZE=5
HANA_MAX_OVERFLOW=10
HANA_POOL_RECYCLE=3600
WORKFLOW_API_BASE_URL=https://flow-ai-dev-orchestration-api.cfapps.br10.hana.ondemand.com
CAPABILITIES=["file_content_editing","row_column_manipulation","data_value_injection","field_mapping_logic","attribute_toggling"]

INPUT_SCHEMA={"type":"object","properties":{"message":{"type":"string","description":"User instruction describing the validation when rules are not provided"},"file_id":{"type":"string","description":"Optional file ID used to validate generated rules against file content"}},"required":["message"]}
OUTPUT_SCHEMA={"type":"object","properties":{"message":{"type":"string"}}}
REQUIRED_PARAMETERS=["message"]
REQUIRED_CONFIRMATION=false
NEGATIVE_EXAMPLES=["extract data only","detect headers","what is this workflow","explain this concept","answer my question"]
