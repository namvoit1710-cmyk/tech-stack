APP_MODE=REST
DB_ECHO=false
DATABASE_URL=sqlite+aiosqlite:///./app.db
PORT=8000
MAX_FILE_SIZE=100
BATCH_SIZE=500000

FILE_SERVER_URL=https://smdg-ai-dev-file-service-qas.cfapps.br10.hana.ondemand.com/api/v1
FILE_SERVICE_CONNECT_TIMEOUT_SEC=10
FILE_SERVICE_READ_TIMEOUT_SEC=120
FILE_SERVICE_UPLOAD_TIMEOUT_SEC=300
FILE_SERVICE_UPLOAD_MODE=multipart
FILE_SERVICE_MAX_RETRIES=2
FILE_SERVICE_RETRY_BACKOFF_SEC=1.5
FILE_SERVICE_FAIL_FAST_ON_TIMEOUT=true
FILE_SERVICE_USE_PRESIGNED_DOWNLOAD_FOR_LARGE=true
FILE_SERVICE_PRESIGNED_DOWNLOAD_MIN_SIZE_MB=25
FILE_SERVICE_PRESIGNED_DOWNLOAD_EXPIRES_SEC=3600
FILE_SERVICE_USE_PRESIGNED_UPLOAD_FOR_LARGE=true
FILE_SERVICE_PRESIGNED_UPLOAD_MIN_SIZE_MB=100
TRANSFORM_LAZY_CSV_FAST_PATH_ENABLED=false
TRANSFORM_LAZY_CSV_SINK_ENABLED=true
ROW_TRANSFORM_PREVIEW_MAX_ROWS=10
ROW_TRANSFORM_PREVIEW_MAX_COLUMNS=60
# Verbose performance profiling (psutil-based); off by default
PERFORMANCE_PROFILING_ENABLED=false
# Comma-separated allowed CORS origins (empty = no cross-origin access; never use "*")
CORS_ALLOW_ORIGINS=
